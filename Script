-- =====================================================================
-- ФОРМА КРИЛА (права сторона; ліва дзеркалиться). x - назовні, y - вгору, z - до глядача (товщина).
-- Початок координат - шарнір.
-- =====================================================================
-- Кістки руки (від суглоба до суглоба). Вужчі крила - зменшіть X, вищі - збільшіть Y.
local ARM = {
	Vector3.new(0.34, 0.83, 0),
	Vector3.new(0.37, 0.59, 0),
	Vector3.new(0.42, 0.43, 0),
}
local ARM_LEN, ARM_TOTAL = {}, 0
for i, v in ipairs(ARM) do
	ARM_LEN[i] = v.Magnitude
	ARM_TOTAL += v.Magnitude
end

-- точка на руці за довжиною дуги u (0..1) -> номер кістки і позиція на ній
local function onArm(u)
	local d = math.clamp(u, 0, 1) * ARM_TOTAL
	for i = 1, #ARM do
		if d <= ARM_LEN[i] or i == #ARM then
			return i, math.clamp(d / ARM_LEN[i], 0, 1)
		end
		d -= ARM_LEN[i]
	end
	return #ARM, 1
end

local PIV = -90 -- кут (градуси), до якого "складається" віяло
local ZSPAN = 0.22 -- наскільки внутрішні пір'їни лежать вище (ближче до глядача), ніж зовнішні

-- t = 0 (біля шарніра, звисають вниз) ... 1 (кінчик крила, дивиться вгору вздовж руки)
local function fAngle(t) return -85 + 140 * (t ^ 1.25) end
local function fLen(t)
	if t < 0.7 then return 0.95 + 0.50 * smooth(t / 0.7) end
	return 1.45 - 0.30 * smooth((t - 0.7) / 0.3)
end
local function fWidth(t) return 0.46 - 0.14 * smooth((t - 0.55) / 0.45) end
local function fArc(t) return 0.16 + 0.84 * t end
local function zF(t) return ZSPAN * (1 - t) end -- висота шару довгих пір'їн
local function zArc(u) return zF(math.clamp((u - 0.16) / 0.84, 0, 1)) end -- те саме за довжиною дуги
local function tiltOf(t) return 0.08 + 0.16 * t end -- підйом кінчика (чаша)

-- Сегменти довгої пір'їни: частка довжини, ширини й товщини (кінчик вужчий і тонший)
local SEGF = {
	[2] = { len = { 0.58, 0.42 }, wid = { 1.0, 0.55 }, thk = { 1.0, 0.65 } },
	[3] = { len = { 0.38, 0.34, 0.28 }, wid = { 1.0, 0.86, 0.48 }, thk = { 1.0, 0.9, 0.62 } },
}

-- Ряди покривних (чим менше рядів, тим довші лусочки)
local ROWS2 = { { off = 0.00, ln = 0.40 }, { off = 0.30, ln = 0.42 } }
local ROWS3 = { { off = 0.00, ln = 0.30 }, { off = 0.20, ln = 0.32 }, { off = 0.38, ln = 0.34 } }
local ROWS4 = {
	{ off = 0.00, ln = 0.24 }, { off = 0.13, ln = 0.26 },
	{ off = 0.26, ln = 0.28 }, { off = 0.40, ln = 0.30 },
}

-- Якість: кількість пір'їн, сегментів, покривних, іскор
local QUALITY = {
	Low = { flight = 14, cov = 12, rows = ROWS2, ridge = 6, stray = 3, segs = 2, sparks = 4, shaft = false, fringe = false, down = 0 },
	Medium = { flight = 18, cov = 16, rows = ROWS3, ridge = 8, stray = 5, segs = 3, sparks = 8, shaft = true, fringe = true, down = 6 },
	High = { flight = 24, cov = 22, rows = ROWS4, ridge = 10, stray = 6, segs = 3, sparks = 12, shaft = true, fringe = true, down = 12 },
}

-- Повертає (функцію анімації, special): special.tips - кінчики для слідів, special.sparks - для іскор
local function buildWing(mk, Q)
	local items = {}
	local special = { tips = {}, sparks = {} }
	local rng = Random.new(20260) -- фіксоване зерно: крила щоразу однакові
	local function R(a, b) return a + (b - a) * rng:NextNumber() end

	-- Спокійніший розкид: стискає випадкове значення до середини діапазону.
	-- CALM: 0 = ідеально рівно, 1 = дуже хаотично
	local CALM = 0.45
	local function Jt(a, b)
		local m = (a + b) / 2
		return m + (R(a, b) - m) * CALM
	end

	local NS = Q.segs
	local SG = SEGF[NS]
	local ROWS = Q.rows

	-- сегменти однієї пір'їни: далі від основи - світліше (tint) й світліша хвиля (pos)
	local function mkSegs(role, shade, t, tb)
		local segs = {}
		for i = 1, NS do
			local f = (i - 1) / math.max(NS - 1, 1)
			segs[i] = mk("ball", role, shade * (1 - 0.8 * f), tb + 0.08 + 0.62 * f + 0.2 * t, t + 0.12 * f)
		end
		return segs
	end

	-- стрижень (rachis): тонка яскрава лінія вздовж кожного сегмента
	local function mkShaft(role, t)
		local sh = {}
		for i = 1, NS do
			local f = (i - 1) / math.max(NS - 1, 1)
			sh[i] = mk("ball", role, 0, 0.75 + 0.2 * f, t + 0.12 * f)
		end
		return sh
	end

	-- два розщеплені "пальці" на кінчику махової пір'їни
	local function mkFringe(role, t)
		return { mk("ball", role, 0, 0.9, t), mk("ball", role, 0, 0.9, t) }
	end

	for _, s in ipairs(SIDES) do
		-- нижній шар довгих пір'їн (зі зсувом на пів кроку - закриває щілини у віялі)
		for k = 1, Q.flight - 1 do
			local t = (k - 0.5) / (Q.flight - 1)
			local b, bt = onArm(fArc(t))
			local v = ARM[b]
			items[#items + 1] = {
				kind = "under", s = s, b = b,
				rel = Vector3.new(s * v.X * bt, v.Y * bt, 0),
				t = t, ang = fAngle(t), len = fLen(t) * 0.93, w = fWidth(t), th = 0.09,
				jl = Jt(0.78, 1.22), ja = Jt(-7, 7), jw = Jt(0.8, 1.25), jt = Jt(-0.08, 0.08), jc = Jt(-0.04, 0.04), tw = Jt(-0.45, 0.45),
				fa = R(0.005, 0.025), fs = R(1.1, 2.6), fp = R(0, 6.28),
				z = zF(t) - 0.075 + R(-0.01, 0.01),
				order = 0.9 * t,
				segs = mkSegs(2, R(0.10, 0.30), t, -0.1),
			}
		end
		-- верхній шар довгих пір'їн (вигнуті, зі світлим загостреним кінчиком)
		for k = 1, Q.flight do
			local t = (k - 1) / (Q.flight - 1)
			local b, bt = onArm(fArc(t))
			local v = ARM[b]
			local role = (t > 0.55) and 1 or 2
			local jl = Jt(0.8, 1.28)
			if rng:NextNumber() < 0.06 then jl = jl * R(0.8, 0.92) end -- рідкісна трохи коротша пір'їна
			local it = {
				kind = "flight", s = s, b = b,
				rel = Vector3.new(s * v.X * bt, v.Y * bt, 0),
				t = t, ang = fAngle(t), len = fLen(t), w = fWidth(t), th = 0.10,
				jl = jl, ja = Jt(-6, 6), jw = Jt(0.8, 1.3), jt = Jt(-0.1, 0.1), jc = Jt(-0.04, 0.04), tw = Jt(-0.45, 0.45),
				fa = R(0.005, 0.03), fs = R(1.1, 2.8), fp = R(0, 6.28),
				z = zF(t) + R(-0.01, 0.01),
				order = 0.9 * t,
				segs = mkSegs(role, R(0.0, 0.22), t, 0),
				shaft = Q.shaft and mkShaft(role, t) or nil,
				fringe = (Q.fringe and t > 0.6) and mkFringe(role, t) or nil,
			}
			items[#items + 1] = it
			-- кінчики найдовших пір'їн отримують сліди, кожна 4-та - іскри
			if k == Q.flight or k == math.floor(Q.flight * 0.8) then
				table.insert(special.tips, it.segs[NS])
			elseif k % 4 == 0 and t > 0.55 then
				table.insert(special.sparks, it.segs[NS])
			end
		end
		-- покривні (лусочки лежать впритул на довгих пір'ях)
		for j = 1, Q.cov do
			local t = (j - 1) / (Q.cov - 1)
			local b, bt = onArm(fArc(t))
			local v = ARM[b]
			local L = fLen(t)
			local W = fWidth(t) * 0.78
			for ri, row in ipairs(ROWS) do
				items[#items + 1] = {
					kind = "cov", s = s, b = b,
					rel = Vector3.new(s * v.X * bt, v.Y * bt, 0),
					t = t, ang = fAngle(t), off = row.off * L, ln = row.ln * L, w = W, th = 0.085,
					jl = Jt(0.85, 1.2), ja = Jt(-5, 5), jw = Jt(0.85, 1.2), jt = Jt(-0.05, 0.05),
					fa = R(0.003, 0.018), fs = R(1.0, 2.5), fp = R(0, 6.28),
					z = zF(t) + 0.065 + (#ROWS - ri) * 0.05 + 0.0006 * j,
					order = 0.9 * t + 0.05,
					body = mk("ball", 3, 0.03 * (ri - 1) + R(0.0, 0.15), 0.15 + 0.1 * ri / #ROWS, t),
				}
			end
		end
		-- кілька довших пір'їн, що трохи вибиваються з крила
		for j = 1, Q.stray do
			local t = R(0.25, 0.95)
			local b, bt = onArm(fArc(t))
			local v = ARM[b]
			local role = (t > 0.55) and 1 or 2
			local it = {
				kind = "stray", s = s, b = b,
				rel = Vector3.new(s * v.X * bt, v.Y * bt, 0),
				t = t, ang = fAngle(t), len = fLen(t), w = R(0.18, 0.26), th = 0.07,
				jl = R(1.05, 1.28), ja = R(-9, 11), jw = 1, jt = R(0.0, 0.15), jc = R(0.0, 0.08), tw = R(-0.3, 0.3),
				fa = R(0.01, 0.04), fs = R(1.5, 3.0), fp = R(0, 6.28),
				z = zF(t) + R(0.0, 0.12),
				order = 0.9 * t + 0.1,
				segs = mkSegs(role, R(0.0, 0.2), t, 0.05),
				shaft = Q.shaft and mkShaft(role, t) or nil,
			}
			items[#items + 1] = it
			table.insert(special.sparks, it.segs[NS])
		end
		-- пух: маленькі напівпрозорі пір'їнки біля руки
		for j = 1, Q.down do
			local u = R(0.0, 0.7)
			local b, bt = onArm(u)
			local v = ARM[b]
			items[#items + 1] = {
				kind = "down", s = s, b = b,
				rel = Vector3.new(s * v.X * bt, v.Y * bt, 0),
				t = u, ang = R(-110, 35), len = R(0.28, 0.5), w = R(0.14, 0.22), th = 0.11,
				fa = R(0.04, 0.10), fs = R(1.4, 3.0), fp = R(0, 6.28),
				z = zArc(u) + R(0.12, 0.30),
				order = 0.9 * u + 0.2,
				body = mk("ball", 3, R(0.0, 0.1), 0.45 + 0.3 * R(0, 1), u, 0.35),
			}
		end
		-- товстий гребінь по передньому краю (найвища точка крила)
		for i = 1, Q.ridge do
			local u = (i - 1) / (Q.ridge - 1)
			local b, bt = onArm(u)
			local v = ARM[b]
			items[#items + 1] = {
				kind = "ridge", s = s, b = b,
				rel = Vector3.new(s * v.X * bt, v.Y * bt, 0),
				u = u, order = 0.9 * u,
				len = 0.55, wd = 0.30 - 0.12 * u, th = 0.28 - 0.12 * u,
				z = zArc(u) + 0.24,
				body = mk("ball", 4, 0.02 * (i % 2), 0, u * 0.8),
			}
		end
	end

	-- стан анімації (плавно наближається до цілі)
	local spread, ampS, ampL, liftB, sweepB = 1, 0.03, 0.03, 0.0, math.rad(12)
	local ph = 0
	local latS, kick, wasAir = 0, 0, false
	local prevA0, wv = 0, 0

	local anim = function(c)
		local dt = c.dt or 0.016
		local sz = c.sz
		local ch = c.ch
		local k = math.min(1, dt * 4)
		local run = math.clamp((c.run or 0) / 24, 0, 1)
		local vy = c.vy or 0

		-- приземлення: невеликий відскок і тріпотіння
		if wasAir and not c.air then kick = 1 end
		wasAir = c.air
		kick = kick * math.exp(-dt * 3.2)

		-- інерція від бігу вбік (згладжена)
		local lat = math.clamp((c.lvx or 0) / 30, -1, 1)
		latS += (lat - latS) * math.min(1, dt * 3)

		local spT, ampST, ampLT, liftT, swT, spd
		if c.fall then
			-- швидке падіння: крила складаються вгору
			spT, ampST, ampLT, liftT, swT, spd = 0.35, 0.04, 0.06, 0.45, math.rad(25), 2
		elseif c.air and vy < -2 then
			-- ширяння: крила широко розправлені, повільні помахи
			spT, ampST, ampLT, liftT, swT, spd = 1.0, 0.06, 0.10, 0.12, math.rad(8), 2.5
		elseif c.air then
			-- зліт / утримання в повітрі: сильні помахи
			local rise = vy > 4
			spT, ampST, ampLT, liftT, swT, spd = 1.0, rise and 0.30 or 0.25, rise and 0.50 or 0.42, -0.10, math.rad(10), rise and 9 or 8
		else
			-- на землі: дихання, на бігу трохи назад
			spT, ampST, ampLT, liftT, swT, spd = 1.0, 0.03, 0.03, 0.03 * run, math.rad(12 + 6 * run), 1.2 + 1.5 * run
		end
		ampLT += 0.25 * kick
		liftT += 0.4 * kick
		spd += 5 * kick

		spread += (spT - spread) * k
		ampS += (ampST - ampS) * k
		ampL += (ampLT - ampL) * k
		liftB += (liftT - liftB) * k
		sweepB += (swT - sweepB) * k
		ph += dt * spd * (Wings.speed / 5)
		c.flapAmt = ampL

		local a0 = liftB + 0.03 * math.sin(c.clk * 1.4) + ampL * flapWave(ph - 0.3)
		local fold = 1 - spread

		-- кутова швидкість крила: пір'я відстає у протилежний бік (інерція)
		local wvRaw = (a0 - prevA0) / math.max(dt, 1e-3)
		prevA0 = a0
		wv += (math.clamp(wvRaw, -40, 40) - wv) * math.min(1, dt * 12)
		local dragBase = -math.clamp(wv * 0.035, -0.5, 0.5)

		-- кістки: шарнір -> 3 суглоби руки (з відставанням, як у справжнього крила)
		local Fb = {}
		for _, s in ipairs(SIDES) do
			local sw = math.max(sweepB + ampS * flapWave(ph) - s * latS * 0.12, -0.2)
			local U = { hingeCF(s, sw) * CFrame.Angles(0, 0, s * a0) }
			for kk = 1, #ARM do
				local v = ARM[kk]
				local ang = -fold * 0.35 + ampL * 0.45 * flapWave(ph - 0.7 * kk) + 0.02 * math.sin(c.clk * 1.1 + kk)
				U[kk + 1] = U[kk] * CFrame.new(s * v.X * sz, v.Y * sz, 0) * CFrame.Angles(0, 0, s * ang)
			end
			Fb[s] = U
		end

		-- пір'я розкривається віялом на помаху; вітер (біг / повітря) тріпоче ним сильніше
		local sk = (0.5 + 0.5 * spread) * (1 + 0.08 * math.clamp(ampL / 0.42, 0, 1.3) * math.sin(ph - 0.2))
		local fl = 1 + 1.2 * run + (c.air and 0.8 or 0)

		for _, f in ipairs(items) do
			local grow = smooth(c.op * 1.6 - f.order * 0.6)
			local gm = 0.04 + 0.96 * grow
			local S = c.size * gm
			local U = Fb[f.s]
			local Ff = U[f.b] * CFrame.new(f.rel * sz)
			local z = Vector3.new(0, 0, f.z * S)

			if f.kind == "ridge" then
				local v = ARM[f.b]
				local dirn = Vector3.new(f.s * v.X, v.Y, 0).Unit
				local vx = WN:Cross(dirn)
				place(f.body, Ff * CFrame.fromMatrix(z, vx, WN), Vector3.new(f.wd * S, f.th * S, f.len * S))
			elseif f.kind == "down" then
				-- пух: легко гойдається від вітру та помахів
				local aa = math.rad(f.ang) + dragBase * 0.5
					+ f.fa * math.sin(c.clk * f.fs * (0.7 + 0.6 * fl) + f.fp) * (0.6 + 0.5 * fl)
				local d = Vector3.new(f.s * math.cos(aa), math.sin(aa), 0)
				local vx = WN:Cross(d)
				local ln = f.len * S
				place(f.body, Ff * CFrame.fromMatrix(d * (ln / 2) + z, vx, WN), Vector3.new(f.w * S, f.th * S, ln))
			else
				-- розмір розкиданих пір'їн залежить від Chaos (при 0 їх майже не видно)
				local Sx = S
				if f.kind == "stray" then Sx = S * math.clamp(ch * 1.0, 0.03, 1.0) end

				local a = math.rad(PIV + (f.ang + f.ja * ch - PIV) * sk)
				-- тріпотіння: дві гармоніки, щоб рух не виглядав механічним
				local t1 = c.clk * f.fs * (0.7 + 0.6 * fl) + f.fp
				a += f.fa * (math.sin(t1) + 0.4 * math.sin(t1 * 2.3 + f.fp * 1.7)) * (0.3 + ch * 0.6) * fl
				if f.t > 0.5 then -- кінці "хльостають" при помахах
					a += 0.10 * ampL * flapWave(ph - 1.0 - f.t * 2.0 + f.fp * 0.2) * (f.t - 0.5) * 2
				end
				a += dragBase * (0.4 + 0.9 * f.t) -- інерція: кінчики відстають сильніше
				-- пружинне запізнення (вторинна анімація): кінчики реагують повільніше за основу
				local lr = math.min(1, dt * (16 - 9 * f.t))
				if f.sa == nil or c.op < 0.3 then f.sa = a else f.sa += (a - f.sa) * lr end
				a = f.sa

				local tl = tiltOf(f.t) + f.jt * ch
				local wMul = 1 + (f.jw - 1) * ch
				local lMul = 1 + (f.jl - 1) * ch

				if f.kind == "cov" then
					local d = Vector3.new(f.s * math.cos(a), math.sin(a), 0)
					local vx = WN:Cross(d)
					local ca, sa = math.cos(tl), math.sin(tl)
					local dtl = d * ca + WN * sa
					local nt = WN * ca - d * sa
					local ln = math.max(f.ln * lMul * Sx, 0.05)
					place(
						f.body,
						Ff * CFrame.fromMatrix(dtl * (f.off * S + ln / 2) + z, vx, nt),
						Vector3.new(f.w * wMul * Sx, f.th * S, ln)
					)
				else
					-- довга пір'їна: вигнутий ланцюжок сегментів зі стрижнем і скрученням
					local L = math.max(f.len * lMul * Sx, 0.05)
					local w, th = f.w * wMul * Sx, f.th * S
					local curl = 0.10 + 0.10 * f.t + (f.jc or 0) * ch
					curl += 0.25 * ampL * flapWave(ph - 0.9 - f.t * 2.0 + f.fp * 0.2) -- кінчик відстає на помаху
					curl -= math.clamp(wv * 0.02, -0.25, 0.25) * f.t
					if f.sc == nil or c.op < 0.3 then f.sc = curl else f.sc += (curl - f.sc) * lr end
					curl = f.sc
					-- скручування: опахало повертається вздовж довжини, на помаху - сильніше
					local twist = (f.tw or 0) * (0.5 + ch) + 0.35 * ampL * flapWave(ph - 0.8 - f.t * 2.0)

					local pos = z
					local ai = a
					local lastD, lastLen = nil, 0
					for i = 1, NS do
						local dd = Vector3.new(f.s * math.cos(ai), math.sin(ai), 0)
						local vxi = WN:Cross(dd)
						local tli = tl * (0.45 + 0.28 * (i - 1))
						local cai, sai = math.cos(tli), math.sin(tli)
						local dti = dd * cai + WN * sai
						local nti = WN * cai - dd * sai
						-- скручування навколо осі пір'їни
						local rl = (i - 1) * twist
						local cr, sr = math.cos(rl), math.sin(rl)
						local ux = vxi * cr + nti * sr
						local uy = nti * cr - vxi * sr
						local len = SG.len[i] * L
						local ww = w * SG.wid[i]
						local tt = th * SG.thk[i]
						local mid = pos + dti * (len / 2)
						-- асиметрія опахала: ширша частина зміщена до заднього краю
						local side = -f.s * ww * 0.12
						place(
							f.segs[i],
							Ff * CFrame.fromMatrix(mid + ux * side, ux, uy),
							Vector3.new(ww, tt, len * 1.3)
						)
						if f.shaft then
							place(
								f.shaft[i],
								Ff * CFrame.fromMatrix(mid + uy * (tt * 0.5), ux, uy),
								Vector3.new(0.04 * c.size, 0.035 * c.size, len * 1.15)
							)
						end
						lastD, lastLen = dti, len
						pos = pos + dti * len
						ai = ai + curl
					end

					-- розщеплені "пальці" на кінчику
					if f.fringe and lastD then
						local la = ai - curl
						for j = 1, 2 do
							local da = la + ((j == 1) and 1 or -1) * (0.15 + 0.10 * f.t)
							local dd = Vector3.new(f.s * math.cos(da), math.sin(da), 0)
							local vxi = WN:Cross(dd)
							local cai, sai = math.cos(tl * 1.2), math.sin(tl * 1.2)
							local dti = dd * cai + WN * sai
							local nti = WN * cai - dd * sai
							local flen = L * 0.24
							place(
								f.fringe[j],
								Ff * CFrame.fromMatrix(pos - lastD * (lastLen * 0.35) + dti * (flen / 2), vxi, nti),
								Vector3.new(w * 0.24, th * 0.5, flen * 1.3)
							)
						end
					end
				end
			end
		end
	end

	return anim, special
end

-- ---------- ефекти: сліди за кінчиками й іскри
local function buildFx(special, Q)
	local fx = { trails = {}, emit = {} }
	for _, rec in ipairs(special.tips) do
		local p = rec.part
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0.22, 0, 0)
		a0.Parent = p
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(-0.22, 0, 0)
		a1.Parent = p
		local tr = Instance.new("Trail")
		tr.Attachment0, tr.Attachment1 = a0, a1
		tr.Lifetime = 0.55
		tr.MinLength = 0.05
		tr.FaceCamera = true
		tr.LightEmission = 1
		tr.LightInfluence = 0
		tr.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.25),
			NumberSequenceKeypoint.new(1, 1),
		})
		tr.WidthScale = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0),
		})
		tr.Enabled = Wings.trail
		tr.Parent = p
		table.insert(fx.trails, tr)
	end
	for i, rec in ipairs(special.sparks) do
		if i > Q.sparks then break end
		local e = Instance.new("ParticleEmitter")
		e.Rate = 2
		e.Lifetime = NumberRange.new(0.8, 1.6)
		e.Speed = NumberRange.new(0.3, 1.2)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.18),
			NumberSequenceKeypoint.new(1, 0),
		})
		e.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		})
		e.LightEmission = 1
		e.LightInfluence = 0
		e.Drag = 1
		e.Acceleration = Vector3.new(0, 0.6, 0)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-60, 60)
		e.Enabled = Wings.sparks
		e.Parent = rec.part
		table.insert(fx.emit, e)
	end
	Wings.fx = fx
end

-- ---------- побудова крил
local function wingsBuild()
	wingsClear()
	local char = lp.Character
	if not char then return end
	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	if not torso then return end
	local folder = Instance.new("Folder")
	folder.Name = "AuroraWings"
	folder.Parent = char

	local function mk(kind, role, shade, tint, pos, alpha)
		local p = Instance.new("Part")
		p.Size = Vector3.new(0.2, 0.2, 0.2)
		p.Transparency = alpha or 0
		p.Massless = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.Material = Wings.neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if kind == "ball" then
			local m = Instance.new("SpecialMesh")
			m.MeshType = Enum.MeshType.Sphere
			m.Parent = p
		end
		local w = Instance.new("Weld")
		w.Part0 = torso
		w.Part1 = p
		w.Parent = p
		p.Parent = folder
		local r = { part = p, weld = w, role = role, shade = shade or 0, tint = tint or 0, pos = pos or 0 }
		table.insert(Wings.recs, r)
		return r
	end

	-- невидима точка зі світлом за спиною (підсвічує навколишні об'єкти)
	local glow = Instance.new("Part")
	glow.Size = Vector3.new(0.4, 0.4, 0.4)
	glow.Transparency = 1
	glow.Massless = true
	glow.CanCollide = false
	glow.CanTouch = false
	glow.CanQuery = false
	glow.CastShadow = false
	local gw = Instance.new("Weld")
	gw.Part0 = torso
	gw.Part1 = glow
	gw.C0 = CFrame.new(0, 0.8, 0.9)
	gw.Parent = glow
	glow.Parent = folder
	local pl = Instance.new("PointLight")
	pl.Range = 16
	pl.Brightness = 1.6
	pl.Shadows = false
	pl.Enabled = Wings.neon
	pl.Parent = glow

	Wings.folder, Wings.torso, Wings.light = folder, torso, pl
	local Q = QUALITY[Wings.quality] or QUALITY.High
	local anim, special = buildWing(mk, Q)
	Wings.anim = anim
	buildFx(special, Q)
	Wings.open = 0 -- крила розгортаються з нуля
	wingsPaint(wClock)
	for _, e in ipairs(Wings.fx.emit) do e:Emit(6) end -- спалах іскор при появі
end

local function setWings(on)
	Wings.enabled = on
	if on and not Wings.folder then wingsBuild() end
	updateBloom()
end

local function setNeon(on)
	Wings.neon = on
	local m = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
	for _, r in ipairs(Wings.recs) do
		r.part.Material = m
	end
	if Wings.light then Wings.light.Enabled = on end
end

local function setTrail(on)
	Wings.trail = on
	for _, t in ipairs(Wings.fx.trails) do t.Enabled = on end
end

local function setSparks(on)
	Wings.sparks = on
	for _, e in ipairs(Wings.fx.emit) do e.Enabled = on end
end

local function setShimmer(on)
	Wings.shimmer = on
	wingsPaint(wClock) -- повернути базові кольори, якщо вимкнули
end

-- ---------- HALO: кільця-вихри над головою
-- r - радіус, y - висота над центром голови, w - швидкість (знак = напрям), tilt - нахил кільця,
-- n - кількість сегментів, arc - довжина дуги в радіанах (хвіст тягнеться за "головою" вихору)
local HALO_RINGS = {
	{ r = 1.9, y = 2.2, w = 1.7, tilt = 0.22, n = 26, arc = 1.7 },
	{ r = 2.3, y = 2.5, w = -1.2, tilt = -0.18, n = 30, arc = 1.5 },
	{ r = 1.5, y = 1.9, w = 2.3, tilt = 0.12, n = 22, arc = 1.3 },
}

local function haloBuild()
	haloClear()
	local char = lp.Character
	local head = char and char:FindFirstChild("Head")
	if not head then return end
	local folder = Instance.new("Folder")
	folder.Name = "AuroraHalo"
	folder.Parent = char
	for ri, ring in ipairs(HALO_RINGS) do
		for i = 1, ring.n do
			local u = i / ring.n -- 0 = кінець хвоста ... 1 = голова вихору
			local th = 0.05 + 0.13 * u
			local p = Instance.new("Part")
			p.Size = Vector3.new(th, th, ring.r * ring.arc / ring.n * 1.7)
			p.Massless = true
			p.CanCollide = false
			p.CanTouch = false
			p.CanQuery = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			p.Transparency = 0.6 * (1 - u)
			local m = Instance.new("SpecialMesh")
			m.MeshType = Enum.MeshType.Sphere
			m.Parent = p
			local w = Instance.new("Weld")
			w.Part0 = head
			w.Part1 = p
			w.Parent = p
			p.Parent = folder
			table.insert(Halo.recs, { part = p, weld = w, ring = ring, ri = ri, u = u })
		end
	end
	Halo.folder, Halo.head = folder, head
	Halo.open = 0
	haloPaint(Halo.t)
end

local function haloUpdate(dt)
	local head = Halo.head
	if not head or not head.Parent then
		haloClear()
		return
	end
	Halo.open += ((Halo.enabled and 1 or 0) - Halo.open) * math.min(1, dt * 3)
	if not Halo.enabled and Halo.open < 0.03 then
		haloClear()
		return
	end
	Halo.t += dt * Halo.speed / 5
	local t, op = Halo.t, smooth(Halo.open)
	for _, h in ipairs(Halo.recs) do
		local ring = h.ring
		local sgn = ring.w > 0 and 1 or -1
		local th = ring.w * t + (h.u - 1) * ring.arc * sgn
		local R = ring.r * (0.5 + 0.5 * op)
		local cs, sn = math.cos(th), math.sin(th)
		local pos = Vector3.new(R * cs, 0.12 * math.sin(th * 3 + t * 2 + h.ri), R * sn)
		local dir = Vector3.new(-sn, 0, cs) * sgn
		local base = CFrame.new(0, ring.y + 0.1 * math.sin(t * 1.3 + h.ri), 0)
			* CFrame.Angles(ring.tilt, 0, ring.tilt * 0.7)
		h.weld.C0 = base * CFrame.lookAt(pos, pos + dir)
	end
	if Wings.scheme == "Accent" or Wings.scheme == "Rainbow" then
		haloPaint(Halo.t)
	end
end

local function setHalo(on)
	Halo.enabled = on
	if on and not Halo.folder then haloBuild() end
	updateBloom()
end

bind(lp.CharacterAdded, function(char)
	if not (Wings.enabled or Halo.enabled) then return end
	char:WaitForChild("Humanoid", 5)
	task.wait(0.5)
	if lp.Character ~= char then return end
	if Wings.enabled then wingsBuild() end
	if Halo.enabled then haloBuild() end
end)

local CTX = {}
local paintT = 0
bind(RunService.RenderStepped, function(dt)
	if Halo.folder then haloUpdate(dt) end
	if not Wings.folder then return end
	local torso = Wings.torso
	if not torso or not torso.Parent then
		wingsClear()
		return
	end
	-- плавне розгортання / згортання
	Wings.open += ((Wings.enabled and 1 or 0) - Wings.open) * math.min(1, dt * 3.5)
	if not Wings.enabled and Wings.open < 0.03 then
		wingsClear()
		return
	end
	wClock += dt

	-- стан персонажа для анімації
	local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
	local air = hum ~= nil and hum.FloorMaterial == Enum.Material.Air
	local vel = torso.AssemblyLinearVelocity
	local lv = torso.CFrame:VectorToObjectSpace(vel)
	CTX.dt = dt
	CTX.air = air
	CTX.fall = air and vel.Y < -14
	CTX.run = Vector3.new(vel.X, 0, vel.Z).Magnitude
	CTX.vy = vel.Y
	CTX.lvx = lv.X
	CTX.sz = Wings.size * (0.04 + 0.96 * smooth(Wings.open))
	CTX.size = Wings.size
	CTX.op = Wings.open
	CTX.clk = wClock
	CTX.ch = Wings.chaos / 100
	Wings.anim(CTX)

	-- світло й іскри живуть разом з помахами
	local flap = CTX.flapAmt or 0
	if Wings.light then Wings.light.Brightness = 1.3 + 3 * flap end
	for _, e in ipairs(Wings.fx.emit) do e.Rate = 1.5 + 12 * flap end

	-- shimmer / Rainbow / Accent: перефарбування ~25 разів на секунду
	paintT += dt
	if paintT > 0.04 and (Wings.shimmer or Wings.scheme == "Accent" or Wings.scheme == "Rainbow") then
		paintT = 0
		wingsPaint(wClock)
	end
end)


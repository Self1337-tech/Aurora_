---------------------------------------------------------------- ВІЗУАЛЬНІ КРИЛА v3 + HALO (бачиш лише ти)
-- v4 (ПІР'Я): асиметричне опахало зі стрижнем (rachis), скручування пір'їн вздовж довжини,
--   розщеплені "пальці" на кінчиках махових, пухнасті пір'їнки біля плеча, інерція й
--   запізнення кожної пір'їни (пружинна вторинна анімація), природніше тріпотіння.
-- Що нового у v3:
--   * ВИГНУТІ ПІР'ЇНИ: кожна довга пір'їна складається з 2-3 сегментів, що плавно згинаються
--     до кінчика й звужуються (загострений кінчик). Кінці "хльостають" під час помахів;
--   * ГРАДІЄНТ КОЛЬОРУ: від основи до кінчика пір'я світлішає, кінчики яскраво світяться;
--   * SHIMMER: по крилу біжить хвиля світла;
--   * СЛІДИ (Trails) за кінчиками крил і ІСКРИ (Sparkles), що летять від пір'я при помахах;
--   * ФІЗИКА: інерція від бігу вбік, ширяння при падінні, помах при зльоті,
--     "приземлення" з відскоком, пір'я розкривається віялом на помаху, вітер тріпоче пір'я;
--   * ЯКІСТЬ: Low / Medium / High (кількість пір'я) - для слабких телефонів;
--   * ХАОС: повзунок Chaos (стиснуто коефіцієнтом CALM).
-- Анімація процедурна: на землі - дихання, біг - крила назад, в повітрі - помахи,
-- падіння - крила складаються, при вмиканні - плавно розкриваються.
local Wings = {
	enabled = false, scheme = "Neon", size = 0.85, speed = 5, chaos = 25, neon = true,
	quality = "High", trail = true, sparks = true, shimmer = true,
	folder = nil, torso = nil, light = nil, recs = {}, anim = nil, open = 0,
	fx = { trails = {}, emit = {} },
}
local Halo = {
	enabled = false, speed = 5, t = 0, open = 0,
	folder = nil, head = nil, recs = {},
}

local SIDES = { 1, -1 }
local WN = Vector3.new(0, 0, 1) -- нормаль площини крила
local WHITE, BLACK = Color3.new(1, 1, 1), Color3.new(0, 0, 0)
local function mix(a, b, t) return a:Lerp(b, math.clamp(t, 0, 1)) end
local function smooth(x) x = math.clamp(x, 0, 1) return x * x * (3 - 2 * x) end

-- Шарнір на нижній частині спини
local function hingeCF(s, sweep)
	return CFrame.new(s * 0.28, 0.35, 0.30) * CFrame.Angles(0, -s * sweep, 0)
end

-- ---------- палітри: [1] первинні, [2] другорядні, [3] покривні / світлі кінчики, [4] гребінь / голова halo
local PAL_DEFAULT = {
	Color3.fromRGB(196, 199, 208), Color3.fromRGB(216, 219, 226),
	Color3.fromRGB(178, 181, 190), Color3.fromRGB(150, 152, 162),
}
local SCHEMES = {
	Neon = { Color3.fromRGB(110, 215, 255), Color3.fromRGB(190, 240, 255), Color3.fromRGB(235, 252, 255), Color3.fromRGB(255, 255, 255) },
	White = { Color3.fromRGB(246, 248, 255), Color3.fromRGB(255, 255, 255), Color3.fromRGB(234, 239, 250), Color3.fromRGB(225, 208, 170) },
	Gold = { Color3.fromRGB(255, 215, 110), Color3.fromRGB(255, 235, 160), Color3.fromRGB(255, 248, 210), Color3.fromRGB(200, 150, 60) },
	Dark = { Color3.fromRGB(28, 28, 38), Color3.fromRGB(42, 40, 56), Color3.fromRGB(62, 58, 82), Color3.fromRGB(90, 85, 100) },
	Ice = { Color3.fromRGB(150, 205, 255), Color3.fromRGB(190, 225, 255), Color3.fromRGB(240, 250, 255), Color3.fromRGB(220, 240, 255) },
	Fire = { Color3.fromRGB(255, 140, 40), Color3.fromRGB(255, 195, 70), Color3.fromRGB(255, 235, 130), Color3.fromRGB(200, 60, 20) },
	Galaxy = { Color3.fromRGB(90, 70, 230), Color3.fromRGB(150, 95, 255), Color3.fromRGB(255, 120, 230), Color3.fromRGB(225, 205, 255) },
}

local function curPal(clk)
	local sc = Wings.scheme
	if sc == "Default" then return PAL_DEFAULT end
	if SCHEMES[sc] then return SCHEMES[sc] end
	if sc == "Accent" then
		return { mix(C.on, BLACK, 0.2), C.on, mix(C.on, WHITE, 0.45), mix(C.on, WHITE, 0.7) }
	end
	local h = clk * 0.1 -- Rainbow
	return {
		Color3.fromHSV(h % 1, 0.75, 1), Color3.fromHSV((h + 0.08) % 1, 0.65, 1),
		Color3.fromHSV((h + 0.16) % 1, 0.45, 1), Color3.fromHSV((h + 0.5) % 1, 0.3, 1),
	}
end

local wClock = 0

-- Фарбування крил: основа -> світлий кінчик (tint), затемнення (shade), хвиля shimmer (pos)
local function wingsPaint(clk)
	local pal = curPal(clk)
	local sh = Wings.shimmer
	for _, r in ipairs(Wings.recs) do
		local col = mix(pal[r.role], pal[3], r.tint)
		col = mix(col, BLACK, r.shade)
		if sh then
			local w = 0.5 + 0.5 * math.sin(clk * 2.4 - r.pos * 8)
			col = mix(col, WHITE, w * w * w * 0.5)
		end
		r.part.Color = col
	end
	if Wings.light then Wings.light.Color = pal[2] end
	local fx = Wings.fx
	if #fx.trails > 0 then
		local cs = ColorSequence.new(pal[3], pal[1])
		for _, t in ipairs(fx.trails) do t.Color = cs end
	end
	if #fx.emit > 0 then
		local cs = ColorSequence.new(pal[3], pal[2])
		for _, e in ipairs(fx.emit) do e.Color = cs end
	end
end

local function haloPaint(clk)
	local pal = curPal(clk)
	for _, h in ipairs(Halo.recs) do
		h.part.Color = mix(pal[1], pal[4], h.u)
	end
end


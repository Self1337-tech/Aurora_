	l.TextSize = size
	l.TextColor3 = color
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextTruncate = Enum.TextTruncate.AtEnd
	setFont(l)
	l.Position = pos
	l.Size = sz
	l.Parent = parent
	return l
end


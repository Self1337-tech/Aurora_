-- Налаштування й хуки для майбутніх функцій
local Settings, Hooks = {}, {}
local function fire(flag, value)
	if not flag then return end
	Settings[flag] = value
	local h = Hooks[flag]
	if h then task.spawn(h, value) end
end

-- З'єднання (щоб чисто вивантажити меню)
local conns = {}
local function bind(signal, fn)
	local c = signal:Connect(fn)
	table.insert(conns, c)
	return c
end

local accentFns = {}
local function onAccent(fn)
	table.insert(accentFns, fn)
end
local function setAccent(col)
	C.on = col
	for _, fn in ipairs(accentFns) do
		fn(col)
	end
end

local function tw(obj, t, props, style, dir)
	local tween = TweenService:Create(
		obj,
		TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

local function setFont(o)
	if CUSTOM_FONT then
		o.FontFace = CUSTOM_FONT
	else
		o.Font = FONT
	end
end

local function corner(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = obj

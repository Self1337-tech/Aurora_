local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function pressFx(btn, ripple, noScale)
	local sc = Instance.new("UIScale")
	sc.Parent = btn
	if ripple then btn.ClipsDescendants = true end
	btn.InputBegan:Connect(function(i)
		if not isPress(i) then return end
		if not noScale then tw(sc, 0.1, { Scale = 0.95 }) end
		if ripple then
			local rel = (Vector2.new(i.Position.X, i.Position.Y) - btn.AbsolutePosition) / uiScale.Scale
			local r = Instance.new("Frame")
			r.AnchorPoint = Vector2.new(0.5, 0.5)
			r.Position = UDim2.fromOffset(rel.X, rel.Y)
			r.Size = UDim2.fromOffset(0, 0)
			r.BackgroundColor3 = Color3.new(1, 1, 1)
			r.BackgroundTransparency = 0.8
			r.BorderSizePixel = 0
			r.ZIndex = 5
			r.Parent = btn
			corner(r, 200)
			tw(r, 0.55, { Size = UDim2.fromOffset(150, 150), BackgroundTransparency = 1 })
			task.delay(0.6, function() r:Destroy() end)
		end
	end)
	btn.InputEnded:Connect(function(i)
		if isPress(i) and not noScale then tw(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back) end
	end)
end

---------------------------------------------------------------- ПЕРЕТЯГУВАННЯ
local HOLD_TIME = 0.18
local HOLD_SLOP = 24
local function makeDraggable(handle, target, onClick, onPress, onRelease)
	local dragInput, moved, held, dead = nil, false, false, false
	local startInput, startPos
	local goal, cur = Vector2.zero, Vector2.zero
	local conn
	local holdId = 0

	local function apply()
		target.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + cur.X,
			startPos.Y.Scale, startPos.Y.Offset + cur.Y
		)
	end

	local function ensureLoop()
		if conn then return end
		conn = RunService.RenderStepped:Connect(function(dt)
			cur = cur:Lerp(goal, 1 - math.exp(-dt * DRAG_SMOOTH))
			apply()
			if not dragInput and (goal - cur).Magnitude < 0.3 then
				cur = goal
				apply()
				conn:Disconnect()
				conn = nil
			end
		end)
	end

	handle.InputBegan:Connect(function(i)
		if dragInput or not isPress(i) then return end
		dragInput, moved, held, dead = i, false, false, false
		startInput = Vector2.new(i.Position.X, i.Position.Y)
		startPos = target.Position
		cur, goal = Vector2.zero, Vector2.zero
		holdId += 1
		local my = holdId
		task.delay(HOLD_TIME, function()
			if dragInput == i and holdId == my and not dead then
				held = true
				if onPress then onPress() end
			end
		end)
	end)

	bind(UserInputService.InputChanged, function(i)
		if not dragInput then return end
		local mine
		if dragInput.UserInputType == Enum.UserInputType.Touch then
			mine = (i == dragInput)
		else
			mine = (i.UserInputType == Enum.UserInputType.MouseMovement)
		end
		if not mine then return end
		local d = Vector2.new(i.Position.X, i.Position.Y) - startInput
		if not held then
			if d.Magnitude > HOLD_SLOP then dead = true end
			return
		end
		if not moved and d.Magnitude > 3 then
			moved = true
			ensureLoop()
		end
		if moved then goal = d end
	end)

	bind(UserInputService.InputEnded, function(i)
		if not dragInput then return end
		local mine = (i == dragInput)
			or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseButton1)
		if not mine then return end
		dragInput = nil
		if held then
			if onRelease then onRelease() end
		elseif not dead and onClick then
			onClick()
		end
	end)
end


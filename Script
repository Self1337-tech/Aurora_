		t.Completed:Connect(function()
			if token == my then holder.Visible = false end
		end)
	end
end

local function flip()
	isOpen = not isOpen
	setOpen(isOpen)
end

makeDraggable(mark, markRoot, flip, function()
	tw(markScale, 0.15, { Scale = 0.88 })
end, function()
	tw(markScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
end)

minBtn.Activated:Connect(function()
	isOpen = false
	setOpen(false)
end)

bind(UserInputService.InputBegan, function(i, processed)
	if processed then return end
	if i.KeyCode == HOTKEY then flip() end
end)


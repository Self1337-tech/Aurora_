--=====================================================================
--  ANGEL WINGS -> Aurora Menu : інтеграція в 3 кроки
--  Крок 1: вставити ЧАСТИНУ 1 перед рядком
--          ---------------------------------------------------------------- ВКЛАДКИ (вміст)
--  Крок 2: вставити ЧАСТИНУ 2 в кінець функції buildFun (перед її "end")
--  Крок 3: вставити ЧАСТИНУ 3 в кнопку Unload (першим рядком у callback)
--=====================================================================


--=====================================================================
-- ЧАСТИНА 1 — модуль крил (вставити перед "ВКЛАДКИ (вміст)")
--=====================================================================
---------------------------------------------------------------- ANGEL WINGS (багатошарові крила + ефекти)
local AngelWings = {}
do
	local CFG = {
		Material = Enum.Material.SmoothPlastic,
		Thick = 0.07,
		FeatherDrop = 0.45,
		HaloRadius = 0.75,
		SpeedIdle = 1.4, AmpIdle = 5,
		SpeedWalk = 2.2, AmpWalk = 9,
		SpeedAir = 5.0, AmpAir = 34,
		YawSpread = 25,
		YawFold = 78, RollFold = 20, ElbowFold = -30, WristFold = -20,
	}

	local PALETTES = {
		{ name = "White", base = Color3.fromRGB(248,248,255), tip = Color3.fromRGB(200,215,255), covert = Color3.fromRGB(255,255,255), rachis = Color3.fromRGB(255,225,160) },
		{ name = "Gold",  base = Color3.fromRGB(205,150,40),  tip = Color3.fromRGB(255,228,140), covert = Color3.fromRGB(240,200,90),  rachis = Color3.fromRGB(255,245,190) },
		{ name = "Black", base = Color3.fromRGB(28,28,34),    tip = Color3.fromRGB(75,70,95),    covert = Color3.fromRGB(45,45,58),    rachis = Color3.fromRGB(160,150,190) },
		{ name = "Ice",   base = Color3.fromRGB(140,200,255), tip = Color3.fromRGB(235,250,255), covert = Color3.fromRGB(190,235,255), rachis = Color3.fromRGB(255,255,255) },
		{ name = "Fire",  base = Color3.fromRGB(140,25,25),   tip = Color3.fromRGB(255,150,45),  covert = Color3.fromRGB(215,75,30),   rachis = Color3.fromRGB(255,210,100) },
		{ name = "Pink",  base = Color3.fromRGB(255,150,200), tip = Color3.fromRGB(255,228,242), covert = Color3.fromRGB(255,190,225), rachis = Color3.fromRGB(255,255,255) },
	}
	local SCALES = {
		{ name = "Mini", v = 0.6 }, { name = "Medium", v = 0.9 },
		{ name = "Large", v = 1.2 }, { name = "Huge", v = 1.6 },
	}

	local state = {
		wings = false, anim = true, glow = false, sparkles = true, fold = false,
		feathers = true, trails = true, aura = true, halo = false,
		paletteIdx = 1, scaleIdx = 2,
	}

	local char, humanoid, rootPart, torso
	local wingsFolder, haloFolder, haloWeld, haloBase
	local recolor, ripples, wingList, emitters = {}, {}, {}, {}
	local trails, lights, tipParts, haloParts = {}, {}, {}, {}
	local falling = {}
	local dead = false

	local fxFolder = Instance.new("Folder")
	fxFolder.Name = "AngelWingsFX"
	fxFolder.Parent = workspace

	local P = {
		S = Vector3.new(0.0, 0.0, 0),
		E = Vector3.new(1.1, 1.0, 0),
		W = Vector3.new(2.6, 1.9, 0),
		T = Vector3.new(3.9, 2.1, 0),
	}

	local function colorFor(kind, frac)
		local pal = PALETTES[state.paletteIdx]
		if kind == "covert" then return pal.covert
		elseif kind == "rachis" then return pal.rachis end
		return pal.base:Lerp(pal.tip, frac)
	end

	local function newPart(size, color, parent)
		local p = Instance.new("Part")
		p.Size = size
		p.Color = color
		p.Material = state.glow and Enum.Material.Neon or CFG.Material
		p.Anchored = false
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.CastShadow = false
		p.CFrame = torso.CFrame
		p.Parent = parent
		return p
	end

	local function weld(part0, part1, c0)
		local w = Instance.new("Weld")
		w.Part0 = part0
		w.Part1 = part1
		w.C0 = c0
		w.C1 = CFrame.new()
		w.Parent = part1
		return w
	end

	local function makeEmitter(parent, S)
		local pal = PALETTES[state.paletteIdx]
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Rate = 3
		e.Lifetime = NumberRange.new(1.2, 2.2)
		e.Speed = NumberRange.new(0.2, 0.8)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.3, 0.35 * S),
			NumberSequenceKeypoint.new(1, 0),
		})
		e.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.2, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		})
		e.LightEmission = 1
		e.Acceleration = Vector3.new(0, -0.6, 0)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-60, 60)
		e.Color = ColorSequence.new(pal.covert, pal.rachis)
		e.Enabled = state.sparkles
		e.Parent = parent
		emitters[#emitters + 1] = e
	end

	local function makeTrail(part)
		local pal = PALETTES[state.paletteIdx]
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(-part.Size.X * 0.5, 0, -part.Size.Z * 0.5)
		a0.Parent = part
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(part.Size.X * 0.5, 0, -part.Size.Z * 0.5)
		a1.Parent = part
		local tr = Instance.new("Trail")
		tr.Attachment0 = a0
		tr.Attachment1 = a1
		tr.Lifetime = 0.7
		tr.MinLength = 0.05
		tr.LightEmission = 0.8
		tr.FaceCamera = true
		tr.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(1, 1),
		})
		tr.WidthScale = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0.2),
		})
		tr.Color = ColorSequence.new(pal.tip, pal.covert)
		tr.Enabled = state.trails
		tr.Parent = part
		trails[#trails + 1] = tr
	end

	local function makeLight(parent, S)
		local pal = PALETTES[state.paletteIdx]
		local l = Instance.new("PointLight")
		l.Color = pal.tip
		l.Brightness = 1.2
		l.Range = 9 * S
		l.Shadows = false
		l.Enabled = state.aura
		l.Parent = parent
		lights[#lights + 1] = l
	end

	-- side: 1 = праве крило, -1 = ліве
	local function buildWing(side)
		local S = SCALES[state.scaleIdx].v
		local function mir(v) return Vector3.new(v.X * side, v.Y, v.Z) end

		local attach = Vector3.new(0.5 * side, torso.Name == "UpperTorso" and 0.4 or 0.5, 0.55)

		local function newBone()
			local b = newPart(Vector3.new(0.2, 0.2, 0.2), Color3.new(1, 1, 1), wingsFolder)
			b.Transparency = 1
			return b
		end

		local shoulder, elbow, wrist = newBone(), newBone(), newBone()
		local elbowRel = mir(P.E - P.S) * S
		local wristRel = mir(P.W - P.E) * S

		local sW = weld(torso, shoulder, CFrame.new(attach))
		local eW = weld(shoulder, elbow, CFrame.new(elbowRel))
		local wW = weld(elbow, wrist, CFrame.new(wristRel))
		makeLight(elbow, S)
		makeLight(wrist, S)

		wingList[#wingList + 1] = {
			side = side, attach = attach,
			sW = sW, eW = eW, wW = wW,
			elbowRel = elbowRel, wristRel = wristRel,
		}

		local function feather(bone, origin, p, ang, len, width, z, kind, frac, withRachis, withRipple)
			local a = math.rad(ang)
			local rel = p - origin
			local pos = Vector3.new(rel.X * side, rel.Y, z) * S
			local dir = Vector3.new(math.cos(a) * side, math.sin(a), 0)
			local base = CFrame.lookAt(pos, pos + dir, Vector3.new(0, 0, 1))

			len, width = len * S, width * S
			local shift = CFrame.new(0, 0, -len * 0.5)

			local part = newPart(Vector3.new(width, CFG.Thick * S, len), colorFor(kind, frac), wingsFolder)
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
			local w1 = weld(bone, part, base * shift)
			recolor[#recolor + 1] = { part = part, kind = kind, frac = frac }

			local w2
			if withRachis then
				local r = newPart(Vector3.new(0.04 * S, 0.09 * S, len * 0.94), colorFor("rachis", 0), wingsFolder)
				w2 = weld(bone, r, base * shift)
				recolor[#recolor + 1] = { part = r, kind = "rachis", frac = 0 }
			end

			if withRipple then
				ripples[#ripples + 1] = {
					w1 = w1, w2 = w2, base = base, shift = shift, side = side,
					phase = p.X * 0.4 + p.Y * 0.3,
					amp = math.rad(2 + 5 * frac),
				}
			end
			return part
		end

		local function coverRows(bone, origin, p, ang, len, width, z)
			feather(bone, origin, p, ang, len * 0.46, width * 0.92, z + 0.07, "covert", 0, false, false)
			feather(bone, origin, p + Vector3.new(0, 0.1, 0), ang, len * 0.28, width * 0.80, z + 0.13, "covert", 0, false, false)
		end

		-- плечові (4)
		for i = 1, 4 do
			local t = 0.15 + (i - 1) * 0.18
			local p = P.S:Lerp(P.E, t)
			local ang = -108 + (i - 1) * 5
			local len = 2.2 + (i - 1) * 0.13
			local z = 0.02 * i
			feather(shoulder, P.S, p, ang, len, 0.50, z, "feather", 0.02 * i, true, true)
			coverRows(shoulder, P.S, p, ang, len, 0.50, z)
		end

		-- другорядні (9)
		for i = 1, 9 do
			local t = (i - 1) / 8
			local p = P.E:Lerp(P.W, t)
			local ang = -100 + 4 * (i - 1)
			local len = 2.75 + 0.06 * (i - 1)
			local z = 0.02 * i
			local part = feather(elbow, P.E, p, ang, len, 0.52, z, "feather", 0.15 + 0.25 * t, true, true)
			coverRows(elbow, P.E, p, ang, len, 0.52, z)
			if i == 3 or i == 7 then makeEmitter(part, S) end
		end

		-- первостепенні (9)
		local primLen = { 3.1, 3.4, 3.7, 3.95, 4.15, 4.25, 4.2, 3.95, 3.5 }
		for i = 1, 9 do
			local t = (i - 1) / 8
			local p = P.W:Lerp(P.T, t)
			local ang = -58 + 8.5 * (i - 1)
			local len = primLen[i]
			local wd = 0.52 - 0.02 * (i - 1)
			local z = 0.18 - 0.02 * (i - 1)
			local part = feather(wrist, P.W, p, ang, len, wd, z, "feather", 0.45 + 0.55 * t, true, true)
			coverRows(wrist, P.W, p, ang, len, wd, z)
			if i % 3 == 0 then makeEmitter(part, S) end
			if i == 6 or i == 9 then makeTrail(part) end
			if i >= 4 then tipParts[#tipParts + 1] = part end
		end

		-- алула
		local alulaAng = { 70, 55, 40 }
		local alulaLen = { 0.95, 0.85, 0.75 }
		for i = 1, 3 do
			local p = P.W + Vector3.new(0.1 + 0.05 * i, 0.1, 0)
			feather(wrist, P.W, p, alulaAng[i], alulaLen[i], 0.20, 0.30, "covert", 0, false, false)
		end

		-- передній край
		for j = 1, 5 do
			local p = P.S:Lerp(P.E, (j - 0.5) / 5)
			feather(shoulder, P.S, p, -85, 1.0, 0.34, 0.26, "covert", 0, false, false)
		end
		for j = 1, 6 do
			local p = P.E:Lerp(P.W, (j - 0.5) / 6)
			feather(elbow, P.E, p, -78, 0.95, 0.32, 0.26, "covert", 0, false, false)
		end
		for j = 1, 5 do
			local p = P.W:Lerp(P.T, (j - 0.5) / 5)
			feather(wrist, P.W, p, -40 + 10 * (j - 1), 1.1, 0.30, 0.26, "covert", 0, false, false)
		end
	end

	local function applyColors()
		for _, e in ipairs(recolor) do e.part.Color = colorFor(e.kind, e.frac) end
		local pal = PALETTES[state.paletteIdx]
		for _, em in ipairs(emitters) do em.Color = ColorSequence.new(pal.covert, pal.rachis) end
		for _, tr in ipairs(trails) do tr.Color = ColorSequence.new(pal.tip, pal.covert) end
		for _, l in ipairs(lights) do l.Color = pal.tip end
		for _, hp in ipairs(haloParts) do hp.Color = pal.rachis end
	end

	local function applyGlow()
		local m = state.glow and Enum.Material.Neon or CFG.Material
		for _, e in ipairs(recolor) do e.part.Material = m end
	end

	local function applySparkles()
		for _, em in ipairs(emitters) do em.Enabled = state.sparkles end
	end

	local function buildHalo()
		local head = char and char:FindFirstChild("Head")
		if not head then return end
		local pal = PALETTES[state.paletteIdx]

		haloFolder = Instance.new("Folder")
		haloFolder.Name = "AngelHalo"

		local root = Instance.new("Part")
		root.Size = Vector3.new(0.2, 0.2, 0.2)
		root.Transparency = 1
		root.Anchored = false
		root.CanCollide = false
		root.CanTouch = false
		root.CanQuery = false
		root.Massless = true
		root.CastShadow = false
		root.CFrame = head.CFrame
		root.Parent = haloFolder

		haloBase = CFrame.new(0, head.Size.Y * 0.5 + 0.75, 0)
		haloWeld = weld(head, root, haloBase)

		local N, R = 24, CFG.HaloRadius
		local segLen = 2 * math.pi * R / N * 1.15
		for i = 1, N do
			local a = (i - 1) / N * math.pi * 2
			local seg = Instance.new("Part")
			seg.Size = Vector3.new(segLen, 0.1, 0.1)
			seg.Color = pal.rachis
			seg.Material = Enum.Material.Neon
			seg.Anchored = false
			seg.CanCollide = false
			seg.CanTouch = false
			seg.CanQuery = false
			seg.Massless = true
			seg.CastShadow = false
			seg.CFrame = head.CFrame
			seg.Parent = haloFolder
			weld(root, seg, CFrame.Angles(0, a, 0) * CFrame.new(0, 0, R))
			haloParts[#haloParts + 1] = seg
		end

		local l = Instance.new("PointLight")
		l.Color = pal.rachis
		l.Brightness = 1.5
		l.Range = 8
		l.Shadows = false
		l.Enabled = state.aura
		l.Parent = root
		lights[#lights + 1] = l
	end

	local function applyFx()
		for _, tr in ipairs(trails) do tr.Enabled = state.trails end
		for _, l in ipairs(lights) do l.Enabled = state.aura end
		if haloFolder then haloFolder.Parent = (state.halo and char) or nil end
	end

	local function buildAll()
		if not (char and torso and torso.Parent) then return end
		if wingsFolder then wingsFolder:Destroy() end
		if haloFolder then haloFolder:Destroy() end
		recolor, ripples, wingList, emitters = {}, {}, {}, {}
		trails, lights, tipParts, haloParts = {}, {}, {}, {}
		haloWeld, haloBase = nil, nil

		wingsFolder = Instance.new("Folder")
		wingsFolder.Name = "AngelWings"
		buildWing(1)
		buildWing(-1)
		wingsFolder.Parent = state.wings and char or nil
		buildHalo()
		applyFx()
	end

	local function ensureBuilt()
		if not wingsFolder then buildAll() end
	end

	-- анімація крил
	local t = 0
	local curSpeed, curAmp = CFG.SpeedIdle, CFG.AmpIdle
	local foldA, rippleK = 0, 1
	local lastCycle = 0

	bind(RunService.RenderStepped, function(dt)
		if dead or not state.wings or not wingsFolder or not wingsFolder.Parent then return end
		if not humanoid or not humanoid.Parent or not rootPart then return end

		local vel = rootPart.AssemblyLinearVelocity
		local horiz = Vector3.new(vel.X, 0, vel.Z).Magnitude
		local tSpeed, tAmp
		if humanoid.FloorMaterial == Enum.Material.Air then
			tSpeed, tAmp = CFG.SpeedAir, CFG.AmpAir
		elseif horiz > 2 then
			tSpeed, tAmp = CFG.SpeedWalk, CFG.AmpWalk
		else
			tSpeed, tAmp = CFG.SpeedIdle, CFG.AmpIdle
		end
		if not state.anim then tAmp = 0 end

		local k = math.min(dt * 4, 1)
		curSpeed += (tSpeed - curSpeed) * k
		curAmp += (tAmp - curAmp) * k
		foldA += ((state.fold and 1 or 0) - foldA) * math.min(dt * 3, 1)
		rippleK += ((state.anim and 1 or 0) - rippleK) * k
		t += dt * curSpeed

		local cycle = math.floor((t + math.pi * 0.5) / (math.pi * 2))
		if cycle ~= lastCycle then
			lastCycle = cycle
			if state.sparkles and curAmp > 15 then
				for _, em in ipairs(emitters) do em:Emit(4) end
			end
		end

		local amp = math.rad(curAmp)
		local sh = math.sin(t)
		local el = math.sin(t - 0.7)
		local wr = math.sin(t - 1.4)

		local yaw = math.rad(CFG.YawSpread + (CFG.YawFold - CFG.YawSpread) * foldA)
		local shRot = math.rad(CFG.RollFold) * foldA + sh * amp
		local elRot = math.rad(CFG.ElbowFold) * foldA + (el - sh) * amp * 0.5
		local wrRot = math.rad(CFG.WristFold) * foldA + (wr - el) * amp * 0.6

		for _, w in ipairs(wingList) do
			local s = w.side
			w.sW.C0 = CFrame.new(w.attach) * CFrame.Angles(0, -yaw * s, 0) * CFrame.Angles(0, 0, shRot * s)
			w.eW.C0 = CFrame.new(w.elbowRel) * CFrame.Angles(0, 0, elRot * s)
			w.wW.C0 = CFrame.new(w.wristRel) * CFrame.Angles(0, 0, wrRot * s)
		end

		for _, f in ipairs(ripples) do
			local rip = math.sin(t - f.phase) * f.amp * rippleK * f.side
			local c0 = f.base * CFrame.Angles(0, rip, 0) * f.shift
			f.w1.C0 = c0
			if f.w2 then f.w2.C0 = c0 end
		end
	end)

	-- падаючі пір'я + нимб
	local function spawnFeather()
		local src = tipParts[math.random(#tipParts)]
		if not src or not src.Parent then return end
		local S = SCALES[state.scaleIdx].v

		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.Size = Vector3.new(0.2 * S, 0.03, 0.75 * S)
		p.Color = src.Color
		p.Material = state.glow and Enum.Material.Neon or CFG.Material
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p

		local pos = src.Position + Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 0.6 * S
		p.CFrame = CFrame.new(pos)
		p.Parent = fxFolder

		falling[#falling + 1] = {
			part = p, pos = pos, age = 0,
			life = 2.5 + math.random() * 1.5,
			vel = Vector3.new((math.random() - 0.5) * 0.8, -(0.9 + math.random() * 0.7), (math.random() - 0.5) * 0.8),
			ph = math.random() * 6.28, freq = 1.5 + math.random() * 1.5,
			sway = 1.2, spin = 1 + math.random() * 2,
			rot = CFrame.Angles(0, math.random() * 6.28, 0),
		}
	end

	local feTimer = 0
	bind(RunService.RenderStepped, function(dt)
		if dead then return end
		if haloWeld and haloWeld.Parent and haloBase then
			local c = os.clock()
			haloWeld.C0 = haloBase
				* CFrame.new(0, math.sin(c * 1.6) * 0.06, 0)
				* CFrame.Angles(math.sin(c * 0.9) * 0.05, c * 0.8, math.sin(c * 1.1) * 0.05)
		end

		feTimer -= dt
		if feTimer <= 0 then
			feTimer = CFG.FeatherDrop * (curAmp > 15 and 0.35 or 1) * (0.7 + math.random() * 0.6)
			if state.feathers and state.wings and wingsFolder and wingsFolder.Parent
				and #tipParts > 0 and #falling < 40 then
				spawnFeather()
			end
		end

		for i = #falling, 1, -1 do
			local f = falling[i]
			f.age += dt
			if f.age >= f.life then
				f.part:Destroy()
				table.remove(falling, i)
			else
				local ph = f.age * f.freq + f.ph
				f.pos += (f.vel + Vector3.new(math.sin(ph), 0, math.cos(ph)) * f.sway) * dt
				f.part.CFrame = CFrame.new(f.pos) * f.rot
					* CFrame.Angles(math.sin(f.age * 2 + f.ph) * 0.6, f.age * f.spin, 0)
				f.part.Transparency = math.clamp((f.age / f.life - 0.6) / 0.4, 0, 1)
			end
		end
	end)

	-- персонаж / респавн
	local function onCharacter(newChar)
		local h = newChar:WaitForChild("Humanoid", 10)
		local rp = newChar:WaitForChild("HumanoidRootPart", 10)
		local ts = newChar:WaitForChild("UpperTorso", 5) or newChar:WaitForChild("Torso", 5)
		if dead then return end
		if not (h and rp and ts) then
			warn("AngelWings: не знайдено Humanoid/HumanoidRootPart/торс")
			return
		end
		char, humanoid, rootPart, torso = newChar, h, rp, ts
		wingsFolder, haloFolder, haloWeld, haloBase = nil, nil, nil, nil
		recolor, ripples, wingList, emitters = {}, {}, {}, {}
		trails, lights, tipParts, haloParts = {}, {}, {}, {}
		if state.wings or state.halo then buildAll() end
	end

	bind(lp.CharacterAdded, onCharacter)
	if lp.Character then task.spawn(onCharacter, lp.Character) end

	-- API для меню
	function AngelWings.setWings(on)
		state.wings = on
		if on then ensureBuilt() end
		if wingsFolder then wingsFolder.Parent = on and char or nil end
	end
	function AngelWings.setAnim(on) state.anim = on end
	function AngelWings.setFold(folded) state.fold = folded end
	function AngelWings.setColor(name)
		for i, p in ipairs(PALETTES) do
			if p.name == name then state.paletteIdx = i end
		end
		applyColors()
	end
	function AngelWings.setGlow(on) state.glow = on; applyGlow() end
	function AngelWings.setSparkles(on) state.sparkles = on; applySparkles() end
	function AngelWings.setSize(name)
		for i, s in ipairs(SCALES) do
			if s.name == name then state.scaleIdx = i end
		end
		if wingsFolder then buildAll() end
	end
	function AngelWings.setFeathers(on) state.feathers = on end
	function AngelWings.setTrails(on) state.trails = on; applyFx() end
	function AngelWings.setAura(on) state.aura = on; applyFx() end
	function AngelWings.setHalo(on)
		state.halo = on
		if on then ensureBuilt() end
		applyFx()
	end
	function AngelWings.cleanup()
		dead = true
		fxFolder:Destroy()
		if haloFolder then haloFolder:Destroy() end
		if wingsFolder then wingsFolder:Destroy() end
	end
end



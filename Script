		{ name = "Mini", v = 0.6 }, { name = "Medium", v = 0.9 },
		{ name = "Large", v = 1.2 }, { name = "Huge", v = 1.6 },
	}

	local state = {
		wings = false, anim = true, glow = false, sparkles = true, fold = false,
		feathers = true, trails = true, aura = true, halo = false,
		paletteIdx = 1, scaleIdx = 2,
	}

	local char, humanoid, rootPart, torso
	local wingsFolder, haloFolder, haloWeld, haloBase
	local recolor, ripples, wingList, emitters = {}, {}, {}, {}
	local trails, lights, tipParts, haloParts = {}, {}, {}, {}
	local falling = {}
	local dead = false

	local fxFolder = Instance.new("Folder")
	fxFolder.Name = "AngelWingsFX"
	fxFolder.Parent = workspace

	local P = {
		S = Vector3.new(0.0, 0.0, 0),
		E = Vector3.new(1.1, 1.0, 0),
		W = Vector3.new(2.6, 1.9, 0),
		T = Vector3.new(3.9, 2.1, 0),
	}

	local function colorFor(kind, frac)
		local pal = PALETTES[state.paletteIdx]
		if kind == "covert" then return pal.covert
		elseif kind == "rachis" then return pal.rachis end
		return pal.base:Lerp(pal.tip, frac)
	end

	local function newPart(size, color, parent)
		local p = Instance.new("Part")
		p.Size = size
		p.Color = color
		p.Material = state.glow and Enum.Material.Neon or CFG.Material
		p.Anchored = false
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.CastShadow = false
		p.CFrame = torso.CFrame
		p.Parent = parent
		return p
	end

	local function weld(part0, part1, c0)
		local w = Instance.new("Weld")
		w.Part0 = part0
		w.Part1 = part1
		w.C0 = c0
		w.C1 = CFrame.new()
		w.Parent = part1
		return w
	end

	local function makeEmitter(parent, S)
		local pal = PALETTES[state.paletteIdx]
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Rate = 3
		e.Lifetime = NumberRange.new(1.2, 2.2)
		e.Speed = NumberRange.new(0.2, 0.8)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.3, 0.35 * S),
			NumberSequenceKeypoint.new(1, 0),
		})
		e.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.2, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		})
		e.LightEmission = 1
		e.Acceleration = Vector3.new(0, -0.6, 0)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-60, 60)
		e.Color = ColorSequence.new(pal.covert, pal.rachis)
		e.Enabled = state.sparkles
		e.Parent = parent
		emitters[#emitters + 1] = e
	end

	local function makeTrail(part)
		local pal = PALETTES[state.paletteIdx]
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(-part.Size.X * 0.5, 0, -part.Size.Z * 0.5)
		a0.Parent = part
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(part.Size.X * 0.5, 0, -part.Size.Z * 0.5)
		a1.Parent = part
		local tr = Instance.new("Trail")
		tr.Attachment0 = a0
		tr.Attachment1 = a1
		tr.Lifetime = 0.7
		tr.MinLength = 0.05
		tr.LightEmission = 0.8
		tr.FaceCamera = true
		tr.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(1, 1),
		})
		tr.WidthScale = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0.2),
		})
		tr.Color = ColorSequence.new(pal.tip, pal.covert)
		tr.Enabled = state.trails
		tr.Parent = part
		trails[#trails + 1] = tr
	end

	local function makeLight(parent, S)
		local pal = PALETTES[state.paletteIdx]
		local l = Instance.new("PointLight")
		l.Color = pal.tip
		l.Brightness = 1.2
		l.Range = 9 * S
		l.Shadows = false
		l.Enabled = state.aura
		l.Parent = parent
		lights[#lights + 1] = l
	end

	-- side: 1 = праве крило, -1 = ліве
	local function buildWing(side)
		local S = SCALES[state.scaleIdx].v
		local function mir(v) return Vector3.new(v.X * side, v.Y, v.Z) end

		local attach = Vector3.new(0.5 * side, torso.Name == "UpperTorso" and 0.4 or 0.5, 0.55)

		local function newBone()
			local b = newPart(Vector3.new(0.2, 0.2, 0.2), Color3.new(1, 1, 1), wingsFolder)
			b.Transparency = 1
			return b
		end

		local shoulder, elbow, wrist = newBone(), newBone(), newBone()
		local elbowRel = mir(P.E - P.S) * S
		local wristRel = mir(P.W - P.E) * S

		local sW = weld(torso, shoulder, CFrame.new(attach))
		local eW = weld(shoulder, elbow, CFrame.new(elbowRel))
		local wW = weld(elbow, wrist, CFrame.new(wristRel))
		makeLight(elbow, S)
		makeLight(wrist, S)

		wingList[#wingList + 1] = {
			side = side, attach = attach,
			sW = sW, eW = eW, wW = wW,
			elbowRel = elbowRel, wristRel = wristRel,
		}

		local function feather(bone, origin, p, ang, len, width, z, kind, frac, withRachis, withRipple)
			local a = math.rad(ang)
			local rel = p - origin
			local pos = Vector3.new(rel.X * side, rel.Y, z) * S
			local dir = Vector3.new(math.cos(a) * side, math.sin(a), 0)
			local base = CFrame.lookAt(pos, pos + dir, Vector3.new(0, 0, 1))

			len, width = len * S, width * S
			local shift = CFrame.new(0, 0, -len * 0.5)

			local part = newPart(Vector3.new(width, CFG.Thick * S, len), colorFor(kind, frac), wingsFolder)
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
			local w1 = weld(bone, part, base * shift)
			recolor[#recolor + 1] = { part = part, kind = kind, frac = frac }

			local w2
			if withRachis then
				local r = newPart(Vector3.new(0.04 * S, 0.09 * S, len * 0.94), colorFor("rachis", 0), wingsFolder)
				w2 = weld(bone, r, base * shift)
				recolor[#recolor + 1] = { part = r, kind = "rachis", frac = 0 }
			end

			if withRipple then
				ripples[#ripples + 1] = {
					w1 = w1, w2 = w2, base = base, shift = shift, side = side,
					phase = p.X * 0.4 + p.Y * 0.3,
					amp = math.rad(2 + 5 * frac),
				}
			end
			return part
		end

		local function coverRows(bone, origin, p, ang, len, width, z)
			feather(bone, origin, p, ang, len * 0.46, width * 0.92, z + 0.07, "covert", 0, false, false)
			feather(bone, origin, p + Vector3.new(0, 0.1, 0), ang, len * 0.28, width * 0.80, z + 0.13, "covert", 0, false, false)
		end

		-- плечові (4)
		for i = 1, 4 do
			local t = 0.15 + (i - 1) * 0.18
			local p = P.S:Lerp(P.E, t)
			local ang = -108 + (i - 1) * 5
			local len = 2.2 + (i - 1) * 0.13
			local z = 0.02 * i
			feather(shoulder, P.S, p, ang, len, 0.50, z, "feather", 0.02 * i, true, true)
			coverRows(shoulder, P.S, p, ang, len, 0.50, z)
		end

		-- другорядні (9)
		for i = 1, 9 do
			local t = (i - 1) / 8
			local p = P.E:Lerp(P.W, t)
			local ang = -100 + 4 * (i - 1)
			local len = 2.75 + 0.06 * (i - 1)
			local z = 0.02 * i
			local part = feather(elbow, P.E, p, ang, len, 0.52, z, "feather", 0.15 + 0.25 * t, true, true)
			coverRows(elbow, P.E, p, ang, len, 0.52, z)
			if i == 3 or i == 7 then makeEmitter(part, S) end
		end

		-- первостепенні (9)
		local primLen = { 3.1, 3.4, 3.7, 3.95, 4.15, 4.25, 4.2, 3.95, 3.5 }
		for i = 1, 9 do
			local t = (i - 1) / 8
			local p = P.W:Lerp(P.T, t)
			local ang = -58 + 8.5 * (i - 1)
			local len = primLen[i]
			local wd = 0.52 - 0.02 * (i - 1)
			local z = 0.18 - 0.02 * (i - 1)
			local part = feather(wrist, P.W, p, ang, len, wd, z, "feather", 0.45 + 0.55 * t, true, true)
			coverRows(wrist, P.W, p, ang, len, wd, z)
			if i % 3 == 0 then makeEmitter(part, S) end
			if i == 6 or i == 9 then makeTrail(part) end
			if i >= 4 then tipParts[#tipParts + 1] = part end
		end

		-- алула
		local alulaAng = { 70, 55, 40 }
		local alulaLen = { 0.95, 0.85, 0.75 }
		for i = 1, 3 do
			local p = P.W + Vector3.new(0.1 + 0.05 * i, 0.1, 0)
			feather(wrist, P.W, p, alulaAng[i], alulaLen[i], 0.20, 0.30, "covert", 0, false, false)
		end

		-- передній край
		for j = 1, 5 do
			local p = P.S:Lerp(P.E, (j - 0.5) / 5)
			feather(shoulder, P.S, p, -85, 1.0, 0.34, 0.26, "covert", 0, false, false)
		end
		for j = 1, 6 do
			local p = P.E:Lerp(P.W, (j - 0.5) / 6)
			feather(elbow, P.E, p, -78, 0.95, 0.32, 0.26, "covert", 0, false, false)
		end
		for j = 1, 5 do
			local p = P.W:Lerp(P.T, (j - 0.5) / 5)
			feather(wrist, P.W, p, -40 + 10 * (j - 1), 1.1, 0.30, 0.26, "covert", 0, false, false)
		end
	end

	local function applyColors()
		for _, e in ipairs(recolor) do e.part.Color = colorFor(e.kind, e.frac) end
		local pal = PALETTES[state.paletteIdx]
		for _, em in ipairs(emitters) do em.Color = ColorSequence.new(pal.covert, pal.rachis) end
		for _, tr in ipairs(trails) do tr.Color = ColorSequence.new(pal.tip, pal.covert) end
		for _, l in ipairs(lights) do l.Color = pal.tip end
		for _, hp in ipairs(haloParts) do hp.Color = pal.rachis end
	end

	local function applyGlow()
		local m = state.glow and Enum.Material.Neon or CFG.Material
		for _, e in ipairs(recolor) do e.part.Material = m end
	end

	local function applySparkles()
		for _, em in ipairs(emitters) do em.Enabled = state.sparkles end
	end

	local function buildHalo()
		local head = char and char:FindFirstChild("Head")
		if not head then return end
		local pal = PALETTES[state.paletteIdx]

		haloFolder = Instance.new("Model")
		haloFolder.Name = "AngelHalo"

		local root = Instance.new("Part")
		root.Size = Vector3.new(0.2, 0.2, 0.2)
		root.Transparency = 1
		root.Anchored = false
		root.CanCollide = false
		root.CanTouch = false
		root.CanQuery = false
		root.Massless = true
		root.CastShadow = false
		root.CFrame = head.CFrame
		root.Parent = haloFolder

		haloBase = CFrame.new(0, head.Size.Y * 0.5 + 0.75, 0)
		haloWeld = weld(head, root, haloBase)

		local N, R = 24, CFG.HaloRadius
		local segLen = 2 * math.pi * R / N * 1.15
		for i = 1, N do
			local a = (i - 1) / N * math.pi * 2
			local seg = Instance.new("Part")
			seg.Size = Vector3.new(segLen, 0.1, 0.1)
			seg.Color = pal.rachis
			seg.Material = Enum.Material.Neon
			seg.Anchored = false
			seg.CanCollide = false
			seg.CanTouch = false
			seg.CanQuery = false
			seg.Massless = true
			seg.CastShadow = false
			seg.CFrame = head.CFrame
			seg.Parent = haloFolder
			weld(root, seg, CFrame.Angles(0, a, 0) * CFrame.new(0, 0, R))
			haloParts[#haloParts + 1] = seg
		end

		local l = Instance.new("PointLight")
		l.Color = pal.rachis
		l.Brightness = 1.5
		l.Range = 8
		l.Shadows = false
		l.Enabled = state.aura
		l.Parent = root
		lights[#lights + 1] = l
	end

	local function applyFx()
		for _, tr in ipairs(trails) do tr.Enabled = state.trails end
		for _, l in ipairs(lights) do l.Enabled = state.aura end
		if haloFolder then haloFolder.Parent = (state.halo and accRoot) or nil end
	end

	local function buildAll()
		if not (char and torso and torso.Parent) then return end
		if wingsFolder then wingsFolder:Destroy() end
		if haloFolder then haloFolder:Destroy() end
		recolor, ripples, wingList, emitters = {}, {}, {}, {}
		trails, lights, tipParts, haloParts = {}, {}, {}, {}
		haloWeld, haloBase = nil, nil

		wingsFolder = Instance.new("Model")
		wingsFolder.Name = "AngelWings"
		buildWing(1)
		buildWing(-1)
		wingsFolder.Parent = state.wings and accRoot or nil
		buildHalo()
		applyFx()
	end

	local function ensureBuilt()
		if not wingsFolder then buildAll() end
	end

	-- анімація крил
	local t = 0
	local curSpeed, curAmp = CFG.SpeedIdle, CFG.AmpIdle
	local foldA, rippleK = 0, 1
	local lastCycle = 0

	bind(RunService.RenderStepped, function(dt)
		if dead or not state.wings or not wingsFolder or not wingsFolder.Parent then return end
		if not humanoid or not humanoid.Parent or not rootPart then return end

		local vel = rootPart.AssemblyLinearVelocity
		local horiz = Vector3.new(vel.X, 0, vel.Z).Magnitude
		local tSpeed, tAmp
		if humanoid.FloorMaterial == Enum.Material.Air then
			tSpeed, tAmp = CFG.SpeedAir, CFG.AmpAir
		elseif horiz > 2 then
			tSpeed, tAmp = CFG.SpeedWalk, CFG.AmpWalk
		else
			tSpeed, tAmp = CFG.SpeedIdle, CFG.AmpIdle
		end
		if not state.anim then tAmp = 0 end

		local k = math.min(dt * 4, 1)
		curSpeed += (tSpeed - curSpeed) * k
		curAmp += (tAmp - curAmp) * k
		foldA += ((state.fold and 1 or 0) - foldA) * math.min(dt * 3, 1)
		rippleK += ((state.anim and 1 or 0) - rippleK) * k
		t += dt * curSpeed

		local cycle = math.floor((t + math.pi * 0.5) / (math.pi * 2))
		if cycle ~= lastCycle then
			lastCycle = cycle
			if state.sparkles and curAmp > 15 then
				for _, em in ipairs(emitters) do em:Emit(4) end
			end
		end

		local amp = math.rad(curAmp)
		local sh = math.sin(t)
		local el = math.sin(t - 0.7)
		local wr = math.sin(t - 1.4)

		local yaw = math.rad(CFG.YawSpread + (CFG.YawFold - CFG.YawSpread) * foldA)
		local shRot = math.rad(CFG.RollFold) * foldA + sh * amp
		local elRot = math.rad(CFG.ElbowFold) * foldA + (el - sh) * amp * 0.5
		local wrRot = math.rad(CFG.WristFold) * foldA + (wr - el) * amp * 0.6

		for _, w in ipairs(wingList) do
			local s = w.side
			w.sW.C0 = CFrame.new(w.attach) * CFrame.Angles(0, -yaw * s, 0) * CFrame.Angles(0, 0, shRot * s)
			w.eW.C0 = CFrame.new(w.elbowRel) * CFrame.Angles(0, 0, elRot * s)
			w.wW.C0 = CFrame.new(w.wristRel) * CFrame.Angles(0, 0, wrRot * s)
		end

		for _, f in ipairs(ripples) do
			local rip = math.sin(t - f.phase) * f.amp * rippleK * f.side
			local c0 = f.base * CFrame.Angles(0, rip, 0) * f.shift
			f.w1.C0 = c0
			if f.w2 then f.w2.C0 = c0 end
		end
	end)

	-- падаючі пір'я + нимб
	local function spawnFeather()
		local src = tipParts[math.random(#tipParts)]
		if not src or not src.Parent then return end
		local S = SCALES[state.scaleIdx].v

		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.Size = Vector3.new(0.2 * S, 0.03, 0.75 * S)
		p.Color = src.Color
		p.Material = state.glow and Enum.Material.Neon or CFG.Material
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p

		local pos = src.Position + Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 0.6 * S
		p.CFrame = CFrame.new(pos)
		p.Parent = fxFolder

		falling[#falling + 1] = {
			part = p, pos = pos, age = 0,
			life = 2.5 + math.random() * 1.5,
			vel = Vector3.new((math.random() - 0.5) * 0.8, -(0.9 + math.random() * 0.7), (math.random() - 0.5) * 0.8),
			ph = math.random() * 6.28, freq = 1.5 + math.random() * 1.5,
			sway = 1.2, spin = 1 + math.random() * 2,
			rot = CFrame.Angles(0, math.random() * 6.28, 0),
		}
	end

	local feTimer = 0
	bind(RunService.RenderStepped, function(dt)
		if dead then return end
		if haloWeld and haloWeld.Parent and haloBase then
			local c = os.clock()
			haloWeld.C0 = haloBase
				* CFrame.new(0, math.sin(c * 1.6) * 0.06, 0)
				* CFrame.Angles(math.sin(c * 0.9) * 0.05, c * 0.8, math.sin(c * 1.1) * 0.05)
		end

		feTimer -= dt
		if feTimer <= 0 then
			feTimer = CFG.FeatherDrop * (curAmp > 15 and 0.35 or 1) * (0.7 + math.random() * 0.6)
			if state.feathers and state.wings and wingsFolder and wingsFolder.Parent
				and #tipParts > 0 and #falling < 40 then
				spawnFeather()
			end
		end

		for i = #falling, 1, -1 do
			local f = falling[i]
			f.age += dt
			if f.age >= f.life then
				f.part:Destroy()
				table.remove(falling, i)
			else
				local ph = f.age * f.freq + f.ph
				f.pos += (f.vel + Vector3.new(math.sin(ph), 0, math.cos(ph)) * f.sway) * dt
				f.part.CFrame = CFrame.new(f.pos) * f.rot
					* CFrame.Angles(math.sin(f.age * 2 + f.ph) * 0.6, f.age * f.spin, 0)
				f.part.Transparency = math.clamp((f.age / f.life - 0.6) / 0.4, 0, 1)
			end
		end
	end)

	-- персонаж / респавн
	local function onCharacter(newChar)
		local h = newChar:WaitForChild("Humanoid", 10)
		local rp = newChar:WaitForChild("HumanoidRootPart", 10)
		local ts = newChar:WaitForChild("UpperTorso", 5) or newChar:WaitForChild("Torso", 5)
		if dead then return end
		if not (h and rp and ts) then
			warn("AngelWings: не знайдено Humanoid/HumanoidRootPart/торс")
			return
		end
		if wingsFolder then wingsFolder:Destroy() end
		if haloFolder then haloFolder:Destroy() end
		char, humanoid, rootPart, torso = newChar, h, rp, ts
		wingsFolder, haloFolder, haloWeld, haloBase = nil, nil, nil, nil
		recolor, ripples, wingList, emitters = {}, {}, {}, {}
		trails, lights, tipParts, haloParts = {}, {}, {}, {}
		if state.wings or state.halo then buildAll() end
	end

	bind(lp.CharacterRemoving, function()
		if wingsFolder then wingsFolder:Destroy() end
		if haloFolder then haloFolder:Destroy() end
		wingsFolder, haloFolder, haloWeld, haloBase = nil, nil, nil, nil
	end)
	bind(lp.CharacterAdded, onCharacter)
	if lp.Character then task.spawn(onCharacter, lp.Character) end

	-- API для меню
	function AngelWings.setWings(on)
		state.wings = on
		if on then ensureBuilt() end
		if wingsFolder then wingsFolder.Parent = on and accRoot or nil end
	end
	function AngelWings.setAnim(on) state.anim = on end
	function AngelWings.setFold(folded) state.fold = folded end
	function AngelWings.setColor(name)
		for i, p in ipairs(PALETTES) do
			if p.name == name then state.paletteIdx = i end
		end
		applyColors()
	end
	function AngelWings.setGlow(on) state.glow = on; applyGlow() end
	function AngelWings.setSparkles(on) state.sparkles = on; applySparkles() end
	function AngelWings.setSize(name)
		for i, s in ipairs(SCALES) do
			if s.name == name then state.scaleIdx = i end
		end
		if wingsFolder then buildAll() end
	end
	function AngelWings.setFeathers(on) state.feathers = on end
	function AngelWings.setTrails(on) state.trails = on; applyFx() end
	function AngelWings.setAura(on) state.aura = on; applyFx() end
	function AngelWings.setHalo(on)
		state.halo = on
		if on then ensureBuilt() end
		applyFx()
	end
	function AngelWings.getModel() return wingsFolder end
	function AngelWings.cleanup()
		dead = true
		fxFolder:Destroy()
		if haloFolder then haloFolder:Destroy() end
		if wingsFolder then wingsFolder:Destroy() end
	end
end

---------------------------------------------------------------- CHINESE HAT (конічний бамбуковий капелюх)
local Hats = {}
do
	local CYL = CFrame.Angles(0, 0, math.pi / 2) -- вісь циліндра: X -> Y
	local BLACK, WHITE = Color3.new(0, 0, 0), Color3.new(1, 1, 1)

	local STYLES = {
		{ name = "Lavender", base = Color3.fromRGB(226,188,240), alt = Color3.fromRGB(206,166,226), rib = Color3.fromRGB(245,228,252), trim = Color3.fromRGB(244,222,252), strap = Color3.fromRGB(170,110,200), knob = Color3.fromRGB(250,238,255), mat = Enum.Material.SmoothPlastic },
		{ name = "Straw",  base = Color3.fromRGB(226,196,128), alt = Color3.fromRGB(204,170,100), rib = Color3.fromRGB(168,128,66),  trim = Color3.fromRGB(120,80,42),   strap = Color3.fromRGB(176,38,38),  knob = Color3.fromRGB(110,72,36),   mat = Enum.Material.Fabric },
		{ name = "Bamboo", base = Color3.fromRGB(160,176,92),  alt = Color3.fromRGB(134,152,74),  rib = Color3.fromRGB(96,112,48),   trim = Color3.fromRGB(70,84,36),    strap = Color3.fromRGB(190,60,50),  knob = Color3.fromRGB(80,64,32),    mat = Enum.Material.Fabric },
		{ name = "Black",  base = Color3.fromRGB(30,30,36),    alt = Color3.fromRGB(46,46,54),    rib = Color3.fromRGB(212,172,70),  trim = Color3.fromRGB(212,172,70),  strap = Color3.fromRGB(170,30,38),  knob = Color3.fromRGB(212,172,70),  mat = Enum.Material.SmoothPlastic },
		{ name = "Red",    base = Color3.fromRGB(176,32,40),   alt = Color3.fromRGB(148,22,32),   rib = Color3.fromRGB(238,200,100), trim = Color3.fromRGB(238,200,100), strap = Color3.fromRGB(245,205,90),  knob = Color3.fromRGB(245,205,90),  mat = Enum.Material.SmoothPlastic },
		{ name = "Gold",   base = Color3.fromRGB(236,196,84),  alt = Color3.fromRGB(210,164,56),  rib = Color3.fromRGB(255,238,160), trim = Color3.fromRGB(150,102,32),  strap = Color3.fromRGB(176,38,38),  knob = Color3.fromRGB(255,240,170), mat = Enum.Material.SmoothPlastic },
		{ name = "Jade",   base = Color3.fromRGB(112,196,164), alt = Color3.fromRGB(84,166,136),  rib = Color3.fromRGB(236,214,150), trim = Color3.fromRGB(236,214,150), strap = Color3.fromRGB(200,60,60),  knob = Color3.fromRGB(236,214,150), mat = Enum.Material.SmoothPlastic },
		{ name = "Accent", dyn = true },
	}
	local TILTS = { Straight = { 0, 0 }, Back = { 0.2, 0 }, Forward = { -0.17, 0 }, Side = { 0, 0.2 } }

	local state = {
		on = false, kind = "Smooth", style = 1, tilt = "Straight", spin = true,
		strap = true, weave = true, bands = true, glow = false, sway = true,
	}

	local folder, root, rootWeld, light, head, char
	local recs, tassels, ringList = {}, {}, {}
	local baseC0 = CFrame.new()
	local dead = false

	local function getStyle()
		local s = STYLES[state.style]
		if s.dyn then
			local c = C.on
			return {
				base = c:Lerp(WHITE, 0.25), alt = c, rib = c:Lerp(WHITE, 0.75),
				trim = c:Lerp(WHITE, 0.6), strap = c:Lerp(BLACK, 0.35), knob = c:Lerp(WHITE, 0.8),
				mat = Enum.Material.SmoothPlastic,
			}
		end
		return s
	end

	local function paint()
		local s = getStyle()
		local gl = state.glow or state.kind == "Rings"
		for _, r in ipairs(recs) do
			local k, p = r.kind, r.part
			if k == "base" then
				p.Color, p.Material = s.base, s.mat
			elseif k == "alt" then
				p.Color, p.Material = s.alt, s.mat
			elseif k == "lining" then
				p.Color, p.Material = s.base:Lerp(BLACK, 0.5), s.mat
			elseif k == "rib" then
				p.Color = s.rib
				p.Material = gl and Enum.Material.Neon or s.mat
			elseif k == "trim" then
				p.Color = s.trim
				p.Material = gl and Enum.Material.Neon or Enum.Material.SmoothPlastic
			elseif k == "knob" then
				p.Color = s.knob
				p.Material = gl and Enum.Material.Neon or Enum.Material.SmoothPlastic
			elseif k == "strap" then
				p.Color, p.Material = s.strap, Enum.Material.Fabric
			end
		end
		if light then
			light.Color = s.trim
			light.Enabled = gl
		end
	end

	local function clear()
		if folder then folder:Destroy() end
		folder, root, rootWeld, light = nil, nil, nil, nil
		recs, tassels, ringList = {}, {}, {}
	end

	local function build()
		clear()
		char = lp.Character
		head = char and char:FindFirstChild("Head")
		if not head then return end
		local hs = head.Size
		local S = 1

		folder = Instance.new("Model")
		folder.Name = "Hats"

		root = Instance.new("Part")
		root.Size = Vector3.new(0.2, 0.2, 0.2)
		root.Transparency = 1
		root.Massless = true
		root.CanCollide = false
		root.CanTouch = false
		root.CanQuery = false
		root.CastShadow = false
		root.CFrame = head.CFrame
		root.Parent = folder

		-- центр крайки капелюха трохи нижче верху голови
		-- (Smooth і Rings сидять майже на самій маківці, Woven трохи глибше)
		local drop = (state.kind == "Woven" and 0.22 or 0.1) * hs.Y
		baseC0 = CFrame.new(0, hs.Y / 2 - drop, 0)
		rootWeld = Instance.new("Weld")
		rootWeld.Part0 = head
		rootWeld.Part1 = root
		rootWeld.C0 = baseC0
		rootWeld.Parent = root

		local function mk(kind, shape, size, cf, parentPart)
			local p = Instance.new("Part")
			p.Shape = shape
			p.Size = size
			p.Massless = true
			p.CanCollide = false
			p.CanTouch = false
			p.CanQuery = false
			p.CastShadow = false
			p.TopSurface = Enum.SurfaceType.Smooth
			p.BottomSurface = Enum.SurfaceType.Smooth
			p.CFrame = head.CFrame
			p.Parent = folder
			local w = Instance.new("Weld")
			w.Part0 = parentPart or root
			w.Part1 = p
			w.C0 = cf
			w.Parent = p
			recs[#recs + 1] = { part = p, weld = w, kind = kind }
			return p, w
		end

		if state.kind == "Rings" then
			-- капелюх тільки з кілець: стопка кілець, що зменшуються догори, і обертаються у різні боки
			local Blk, Ball = Enum.PartType.Block, Enum.PartType.Ball
			local nR = 7
			for i = 1, nR do
				local t = (i - 1) / (nR - 1)
				local r = 1.5 * (1 - 0.82 * t ^ 1.15)
				local y = 0.05 + (i - 1) * 0.17
				local th = i == 1 and 0.13 or 0.09
				local rr, rw = mk("ringroot", Blk, Vector3.new(0.1, 0.1, 0.1), CFrame.new(0, y, 0))
				rr.Transparency = 1
				local n = math.max(10, math.floor(r * 15))
				local seg = 2 * math.pi * r / n
				for k = 1, n do
					local a = (k - 1) / n * math.pi * 2
					mk((k % 2 == 0) and "rib" or "trim", Blk, Vector3.new(seg * 0.82, th, th),
						CFrame.Angles(0, a, 0) * CFrame.new(0, 0, r), rr)
				end
				ringList[#ringList + 1] = { weld = rw, y = y, spd = (i % 2 == 0 and 1 or -1) * (0.5 + 0.18 * i), ang = i * 0.7 }
			end
			mk("knob", Ball, Vector3.new(0.2, 0.2, 0.2), CFrame.new(0, 0.05 + (nR - 1) * 0.17 + 0.12, 0))
		elseif state.kind == "Smooth" then
			-- гладкий пласкій конус із трикутників (WedgePart), як на референсі:
			-- менший за раніше (R 1.65 замість 2.1), низький (H 0.8), гострий верх, чиста кромка без обідка
			local R, H, N = 1.65, 0.8, 40
			local function mkW(kind, size, cf)
				local p = Instance.new("WedgePart")
				p.Size = size
				p.Massless = true
				p.CanCollide = false
				p.CanTouch = false
				p.CanQuery = false
				p.CastShadow = false
				p.TopSurface = Enum.SurfaceType.Smooth
				p.BottomSurface = Enum.SurfaceType.Smooth
				p.CFrame = head.CFrame
				p.Parent = folder
				local w = Instance.new("Weld")
				w.Part0 = root
				w.Part1 = p
				w.C0 = cf
				w.Parent = p
				recs[#recs + 1] = { part = p, weld = w, kind = kind }
			end
			local function tri(kind, a, b, c)
				local ab, ac, bc = b - a, c - a, c - b
				local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
				if abd > acd and abd > bcd then
					c, a = a, c
				elseif acd > bcd and acd > abd then
					a, b = b, a
				end
				ab, ac, bc = b - a, c - a, c - b
				local right = ac:Cross(ab).Unit
				local up = bc:Cross(right).Unit
				local back = bc.Unit
				local height = math.abs(ab:Dot(up))
				mkW(kind, Vector3.new(0.02, height, math.abs(ab:Dot(back))),
					CFrame.fromMatrix((a + b) / 2, right, up, back))
				mkW(kind, Vector3.new(0.02, height, math.abs(ac:Dot(back))),
					CFrame.fromMatrix((a + c) / 2, -right, up, -back))
			end
			local apex = Vector3.new(0, H, 0)
			for i = 1, N do
				local a0 = (i - 1) / N * math.pi * 2
				local a1 = i / N * math.pi * 2
				tri("base", apex,
					Vector3.new(R * math.cos(a0), 0, R * math.sin(a0)),
					Vector3.new(R * math.cos(a1), 0, R * math.sin(a1)))
			end
		else
		local R, H, N, pw = 1.85 * S, 1.3 * S, 30, 1.1
		local function prof(t) return R * (1 - t) ^ pw end
		local Cyl, Blk, Ball = Enum.PartType.Cylinder, Enum.PartType.Block, Enum.PartType.Ball

		-- 1) конус: стопка тонких дисків, чергування кольору = кільця плетіння
		for i = 1, N do
			local t0, t1 = (i - 1) / N, i / N
			local r = math.max(prof(t0), 0.03)
			local th = H / N * 1.12
			mk(i % 2 == 0 and "alt" or "base", Cyl,
				Vector3.new(th, r * 2, r * 2),
				CFrame.new(0, (t0 + t1) / 2 * H, 0) * CYL)
		end

		-- 2) підкладка знизу та обідок крайки
		mk("lining", Cyl, Vector3.new(0.03, R * 1.94, R * 1.94), CFrame.new(0, -0.05, 0) * CYL)
		mk("trim", Cyl, Vector3.new(0.09 * S + 0.02, R * 2 + 0.1, R * 2 + 0.1), CFrame.new(0, 0, 0) * CYL)

		-- 3) ребра (спиці) вздовж поверхні конуса, 3 сегменти кожне
		if state.weave then
			local nR = 16
			local pts = { 0.01, 0.36, 0.68, 0.985 }
			for k = 1, nR do
				local a = (k - 1) / nR * math.pi * 2 + 0.1
				for s = 1, #pts - 1 do
					local ta, tb = pts[s], pts[s + 1]
					local ra, rb = prof(ta) + 0.03 * S, prof(tb) + 0.03 * S
					local ha, hb = ta * H, tb * H
					local dr, dh = ra - rb, hb - ha
					local L = math.sqrt(dr * dr + dh * dh)
					local phi = math.atan2(dr, dh)
					mk("rib", Blk, Vector3.new(0.045 * S, L + 0.02, 0.045 * S),
						CFrame.Angles(0, a, 0) * CFrame.new((ra + rb) / 2, (ha + hb) / 2, 0) * CFrame.Angles(0, 0, phi))
				end
			end
		end

		-- 4) декоративні пояски
		if state.bands then
			for _, tb in ipairs({ 0.28, 0.6 }) do
				local r = prof(tb) + 0.05 * S
				mk("trim", Cyl, Vector3.new(0.07 * S, r * 2, r * 2), CFrame.new(0, tb * H, 0) * CYL)
			end
		end

		-- 5) верхівка: стебло + кулька
		mk("knob", Cyl, Vector3.new(0.14 * S, 0.1 * S, 0.1 * S), CFrame.new(0, H - 0.01, 0) * CYL)
		mk("knob", Ball, Vector3.new(0.26 * S, 0.26 * S, 0.26 * S), CFrame.new(0, H + 0.07 * S, 0))

		-- 6) підборідний ремінець з бантом і двома китицями
		if state.strap then
			local chinY = -(hs.Y - drop) - 0.03
			local sx = hs.X / 2 + 0.04
			local zf = -hs.Z * 0.15
			local len = -0.02 - chinY
			for _, sgn in ipairs({ 1, -1 }) do
				mk("strap", Blk, Vector3.new(0.06, len, 0.12), CFrame.new(sgn * sx, (-0.02 + chinY) / 2, 0))
			end
			mk("strap", Blk, Vector3.new(hs.X + 0.14, 0.06, 0.1), CFrame.new(0, chinY, zf))
			mk("strap", Ball, Vector3.new(0.14, 0.14, 0.14), CFrame.new(0, chinY, zf - 0.04))
			for idx, sgn in ipairs({ 1, -1 }) do
				local anchor = Vector3.new(sgn * sx, chinY, zf)
				local body = mk("strap", Blk, Vector3.new(0.07, 0.4, 0.07), CFrame.new(anchor))
				local bead = mk("knob", Ball, Vector3.new(0.14, 0.14, 0.14), CFrame.new(anchor))
				tassels[#tassels + 1] = {
					body = body, bead = bead, anchor = anchor, ph = idx * 1.9,
					bw = recs[#recs - 1].weld, ew = recs[#recs].weld,
				}
			end
		end

		end

		light = Instance.new("PointLight")
		light.Range = 10
		light.Brightness = 1.2
		light.Shadows = false
		light.Parent = root

		paint()
		folder.Parent = state.on and accRoot or nil
	end

	-- анімація: пружини для нахилу від руху, колихання китиць
	local clock = 0
	local pitch, roll, yo, pv, rv, yv = 0, 0, 0, 0, 0, 0
	local function spring(a, v, target, dt)
		v += ((target - a) * 70 - v * 9) * dt
		a += v * dt
		return a, v
	end

	bind(RunService.RenderStepped, function(dt)
		if dead or not folder or not folder.Parent or not rootWeld then return end
		if not head or not head.Parent then return end
		dt = math.min(dt, 1 / 30)
		clock += dt

		local tp, tr, ty = 0, 0, 0
		if state.sway then
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local lv = hrp.CFrame:VectorToObjectSpace(hrp.AssemblyLinearVelocity)
				tp = math.clamp(-lv.Z * 0.009, -0.22, 0.22)
				tr = math.clamp(lv.X * 0.009, -0.22, 0.22)
				ty = math.clamp(lv.Y * 0.0035, -0.08, 0.1)
			end
		end
		pitch, pv = spring(pitch, pv, tp, dt)
		roll, rv = spring(roll, rv, tr, dt)
		yo, yv = spring(yo, yv, ty, dt)

		local idle = state.sway and math.sin(clock * 1.3) * 0.012 or 0
		local tilt = TILTS[state.tilt] or TILTS.Straight
		rootWeld.C0 = baseC0 * CFrame.new(0, yo, 0)
			* CFrame.Angles(pitch + tilt[1] + idle * 0.6, 0, roll + tilt[2] + idle)

		if state.spin then
			for _, rg in ipairs(ringList) do
				rg.ang += rg.spd * dt
				rg.weld.C0 = CFrame.new(0, rg.y, 0) * CFrame.Angles(0, rg.ang, 0)
			end
		end

		local k = state.sway and 1 or 0.3
		for _, ts in ipairs(tassels) do
			local ax = -2.4 * pitch + math.sin(clock * 2 + ts.ph) * 0.06 * k
			local az = -2.4 * roll + math.sin(clock * 1.7 + ts.ph * 1.3) * 0.05 * k
			local pivot = CFrame.new(ts.anchor) * CFrame.Angles(ax, 0, az)
			ts.bw.C0 = pivot * CFrame.new(0, -0.2, 0)
			ts.ew.C0 = pivot * CFrame.new(0, -0.43, 0)
		end
	end)

	bind(lp.CharacterRemoving, function() clear() end)
	bind(lp.CharacterAdded, function(c)
		clear()
		if not state.on then return end
		task.spawn(function()
			c:WaitForChild("Head", 5)
			c:WaitForChild("HumanoidRootPart", 5)
			task.wait(0.4)
			if dead or lp.Character ~= c then return end
			build()
		end)
	end)

	-- перефарбувати при зміні акценту, якщо стиль Accent
	onAccent(function()
		if folder and STYLES[state.style].dyn then paint() end
	end)

	-- API для меню
	function Hats.setEnabled(on)
		state.on = on
		if on and not folder then build() end
		if folder then folder.Parent = on and accRoot or nil end
	end
	function Hats.setStyle(name)
		for i, s in ipairs(STYLES) do
			if s.name == name then state.style = i end
		end
		paint()
	end
	function Hats.setType(name)
		state.kind = name
		if folder then build() end
	end
	function Hats.setSpin(on) state.spin = on end
	function Hats.getModel() return folder end
	function Hats.setTilt(name) state.tilt = name end
	function Hats.setStrap(on) state.strap = on; if folder then build() end end
	function Hats.setWeave(on) state.weave = on; if folder then build() end end
	function Hats.setBands(on) state.bands = on; if folder then build() end end
	function Hats.setGlow(on) state.glow = on; paint() end
	function Hats.setSway(on) state.sway = on end
	function Hats.cleanup()
		dead = true
		clear()
	end
end

---------------------------------------------------------------- CHAMS (переливчасте підсвічування: тіло / крила / капелюх)
local Chams = {}
do
	local WHITE = Color3.new(1, 1, 1)

	-- "Ghost" = голографічний переліив: лавандовий -> рожевий -> блакитний -> м'ятний
	local HOLO = {
		Color3.fromRGB(205, 172, 255),
		Color3.fromRGB(255, 182, 236),
		Color3.fromRGB(168, 226, 255),
		Color3.fromRGB(194, 255, 232),
	}
	local PAL = {
		Aurora = { Color3.fromRGB(70, 230, 255), Color3.fromRGB(150, 100, 255), Color3.fromRGB(255, 110, 220) },
		Ice = { Color3.fromRGB(110, 190, 255), Color3.fromRGB(215, 245, 255), Color3.fromRGB(150, 140, 255) },
		Fire = { Color3.fromRGB(255, 60, 40), Color3.fromRGB(255, 150, 40), Color3.fromRGB(255, 225, 90) },
	}
	local SPEEDS = { Normal = 1, Slow = 0.4, Fast = 2.2 }
	local FILLS = { Light = 0.7, Medium = 0.5, Strong = 0.25, Full = 0 }

	local state = {
		on = false, body = true, wings = true, hat = true,
		mode = "Ghost", speed = 1, fill = 0.7, outline = true, walls = true,
	}

	local container = Instance.new("Folder")
	container.Name = "AuroraChams"
	container.Parent = workspace

	local hl = {}
	local order = { body = 0, wings = 0.33, hat = 0.66 }
	local clock = 0
	local dead = false

	local function cyc(list, x)
		local n = #list
		x = x % n
		local i = math.floor(x)
		local f = x - i
		f = f * f * (3 - 2 * f)
		return list[i + 1]:Lerp(list[(i + 1) % n + 1], f)
	end

	-- повертає (колір заливки, колір контуру)
	local function colorsFor(t, off)
		local m = state.mode
		local fill, outl
		if m == "Ghost" then
			-- заливка й контур переливаються з різним зсувом + блиск (glint) що пробігає
			local glint = 0.5 + 0.5 * math.sin(t * 2.4 + off * 5)
			fill = cyc(HOLO, t * 0.5 + off * 2.5):Lerp(WHITE, 0.1 + 0.25 * glint)
			outl = cyc(HOLO, t * 0.5 + off * 2.5 + 2):Lerp(WHITE, 0.4 + 0.3 * glint)
			return fill, outl
		elseif m == "Rainbow" then
			fill = Color3.fromHSV((t * 0.15 + off) % 1, 0.75, 1)
		elseif m == "Accent" then
			fill = C.on:Lerp(WHITE, 0.55 + 0.45 * math.sin(t * 2 + off * 6))
		else
			fill = cyc(PAL[m] or PAL.Aurora, t * 0.4 + off * 3)
		end
		return fill, fill:Lerp(WHITE, 0.55)
	end

	local function targetOf(kind)
		if kind == "body" then return lp.Character end
		if kind == "wings" then return AngelWings.getModel() end
		return Hats.getModel()
	end

	local function drop(kind)
		if hl[kind] then
			hl[kind]:Destroy()
			hl[kind] = nil
		end
	end

	bind(RunService.RenderStepped, function(dt)
		if dead then return end
		clock += dt * state.speed
		for kind, off in pairs(order) do
			local model = targetOf(kind)
			if state.on and state[kind] and model and model.Parent then
				local h = hl[kind]
				if not h or not h.Parent then
					h = Instance.new("Highlight")
					h.Name = kind
					h.Parent = container
					hl[kind] = h
				end
				if h.Adornee ~= model then h.Adornee = model end
				local fillCol, outCol = colorsFor(clock, off)
				h.FillColor = fillCol
				h.OutlineColor = outCol
				local shimmer = 0.08 * math.sin(clock * 3 + off * 5)
				if state.mode == "Ghost" then
					shimmer += 0.06 * math.sin(clock * 7 + off * 11)
				end
				h.FillTransparency = math.clamp(state.fill + shimmer, 0, 1)
				h.OutlineTransparency = state.outline and 0 or 1
				h.DepthMode = state.walls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
			else
				drop(kind)
			end
		end
	end)

	function Chams.setEnabled(on) state.on = on end
	function Chams.setBody(on) state.body = on end

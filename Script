local function button(pane, title, desc, btnText, callback)
	local row = card(pane, compactMode and 40 or 54)
	label(row, title, 16, C.text, UDim2.fromOffset(12, compactMode and 10 or 8), UDim2.fromOffset(250, 20))
	if not compactMode then
		label(row, desc, 12, C.muted, UDim2.fromOffset(12, 29), UDim2.fromOffset(250, 16))
	end
	local b = pill(row, btnText)
	onAccent(function(c) tw(b, 0.3, { BackgroundColor3 = c }) end)
	b.BackgroundColor3 = C.on
	b.Activated:Connect(function()
		if callback then callback() end
	end)
	return row
end

local function selector(pane, title, desc, options, default, flag, callback)
	local row = card(pane, 54)
	local idx = default or 1
	Settings[flag or title] = options[idx]
	label(row, title, 16, C.text, UDim2.fromOffset(12, 8), UDim2.fromOffset(250, 20))
	label(row, desc, 12, C.muted, UDim2.fromOffset(12, 29), UDim2.fromOffset(250, 16))
	local b = pill(row, options[idx])
	b.Activated:Connect(function()
		idx = idx % #options + 1
		b.Text = options[idx]
		if callback then callback(options[idx]) end
		fire(flag or title, options[idx])
		notify(title .. ": " .. options[idx])
	end)
	return row
end

local function grid(pane, size)
	size = size or 54
	local g = Instance.new("Frame")
	g.BackgroundTransparency = 1
	g.AutomaticSize = Enum.AutomaticSize.Y
	g.Size = UDim2.new(1, -8, 0, 0)
	g.LayoutOrder = nextOrder(pane)
	g.Parent = pane
	local l = Instance.new("UIGridLayout")
	l.CellSize = UDim2.fromOffset(size, size)
	l.CellPadding = UDim2.fromOffset(6, 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = g

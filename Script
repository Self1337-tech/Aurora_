local rot, statTimer = 0, 0
bind(RunService.RenderStepped, function(dt)
	rot = (rot + dt * 70) % 360
	fps += (1 / math.max(dt, 1e-4) - fps) * math.min(1, dt * 4)
	if spin.Visible then spinGrad.Rotation = rot * 2 % 360 end
	if not holder.Visible then return end

	statTimer += dt
	if statTimer > 0.5 and statsLabel then
		statTimer = 0
		local ok, ping = pcall(function() return lp:GetNetworkPing() * 1000 end)
		statsLabel.Text = string.format("FPS %d  |  Ping %d ms", math.floor(fps), math.floor(ok and ping or 0))
	end
end)


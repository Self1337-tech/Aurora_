local function selectTab(name)
	if current == name then return end
	current = name
	for n, b in pairs(buttons) do
		local sel = (n == name)
		tw(b, 0.25, { BackgroundTransparency = sel and 0 or 1 })
		tw(bars[n], 0.25, { BackgroundTransparency = sel and 0 or 1 })
	end
	for n, p in pairs(panes) do
		if n ~= name then p.Visible = false end
	end
	local p = panes[name]
	p.Visible = true
	p.Position = UDim2.fromOffset(16, 0)
	tw(p, 0.35, { Position = UDim2.fromOffset(0, 0) })
	scrolls[name].CanvasPosition = Vector2.zero

	for idx, row in ipairs(rowsByPane[scrolls[name]] or {}) do
		row.BackgroundTransparency = 1
		task.delay(0.05 + math.min(idx, 10) * 0.05, function()
			tw(row, 0.35, { BackgroundTransparency = 0.25 })
		end)
	end
end


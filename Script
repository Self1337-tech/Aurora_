	Settings[flag or title] = state
	local hit = hitArea(row)
	label(row, title, 16, C.text, UDim2.fromOffset(12, compactMode and 10 or 8), UDim2.fromOffset(300, 20))
	if not compactMode then
		label(row, desc, 12, C.muted, UDim2.fromOffset(12, 29), UDim2.fromOffset(300, 16))
	end
	local t = Instance.new("Frame")
	t.AnchorPoint = Vector2.new(0.5, 0.5)
	t.Size = UDim2.fromOffset(48, 26)
	t.Position = UDim2.new(1, -36, 0.5, 0)
	t.BackgroundColor3 = state and C.on or C.off
	t.Parent = row
	corner(t, 13)
	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(20, 20)
	knob.Position = UDim2.fromOffset(state and 25 or 3, 3)
	knob.BackgroundColor3 = Color3.fromRGB(236, 233, 245)
	knob.Parent = t
	corner(knob, 10)
	onAccent(function(c)
		if state then tw(t, 0.3, { BackgroundColor3 = c }) end
	end)
	hit.Activated:Connect(function()
		state = not state
		tw(knob, 0.3, { Position = UDim2.fromOffset(state and 25 or 3, 3) }, Enum.EasingStyle.Back)
		tw(t, 0.25, { BackgroundColor3 = state and C.on or C.off })
		if callback then callback(state) end
		fire(flag or title, state)
		notify(title .. (state and ": ON" or ": OFF"))
	end)
	return row
end

-- Тягнення по області. axisLock = true: на дотик береться лише горизонтальний жест,
-- вертикальний лишається для прокрутки списку
local function dragArea(area, pane, fn, axisLock, onBegin, onEnd)
	local hit = Instance.new("TextButton")
	hit.Text = ""
	hit.BackgroundTransparency = 1
	hit.AutoButtonColor = false
	hit.Size = UDim2.fromScale(1, 1)
	hit.ZIndex = 4
	hit.Parent = area
	local drag, startPos, active, dead = nil, nil, false, false
	local function at(p)
		local rx = math.clamp((p.X - area.AbsolutePosition.X) / area.AbsoluteSize.X, 0, 1)
		local ry = math.clamp((p.Y - area.AbsolutePosition.Y) / area.AbsoluteSize.Y, 0, 1)
		fn(rx, ry)
	end
	local function activate()
		active = true
		pane.ScrollingEnabled = false
		if onBegin then onBegin() end
	end
	hit.InputBegan:Connect(function(i)
		if drag or not isPress(i) then return end
		drag, active, dead = i, false, false
		startPos = Vector2.new(i.Position.X, i.Position.Y)
		if not axisLock or i.UserInputType ~= Enum.UserInputType.Touch then
			activate()
			at(i.Position)
		end
	end)
	bind(UserInputService.InputChanged, function(i)
		if not drag or dead then return end
		local mine
		if drag.UserInputType == Enum.UserInputType.Touch then
			mine = (i == drag)
		else
			mine = (i.UserInputType == Enum.UserInputType.MouseMovement)
		end
		if not mine then return end
		if not active then
			local d = Vector2.new(i.Position.X, i.Position.Y) - startPos
			if d.Magnitude < 6 then return end
			if math.abs(d.X) > math.abs(d.Y) then
				activate()
			else
				dead = true -- вертикальний свайп: це прокрутка
				return
			end
		end
		at(i.Position)
	end)
	bind(UserInputService.InputEnded, function(i)
		if not drag then return end
		local mine = (i == drag)
			or (drag.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseButton1)
		if not mine then return end
		if not active and not dead then at(i.Position) end -- короткий тап = встановити значення
		drag = nil
		if active then
			active = false
			pane.ScrollingEnabled = true
			if onEnd then onEnd() end
		end
		dead = false
	end)
end

local function slider(pane, title, desc, min, max, default, flag, callback, suffix)
	local row = card(pane, compactMode and 54 or 66)
	suffix = suffix or ""
	local value = default
	Settings[flag or title] = value
	local ty = compactMode and 4 or 6
	label(row, title, 16, C.text, UDim2.fromOffset(12, ty), UDim2.fromOffset(220, 20))
	if not compactMode then
		label(row, desc, 12, C.muted, UDim2.fromOffset(12, 25), UDim2.fromOffset(300, 16))
	end
	local num = label(row, tostring(value) .. suffix, 16, C.text, UDim2.new(1, -112, 0, ty), UDim2.fromOffset(100, 20))
	num.TextXAlignment = Enum.TextXAlignment.Right

	local track = Instance.new("Frame")
	track.Position = UDim2.new(0, 12, 0, compactMode and 36 or 50)
	track.Size = UDim2.new(1, -24, 0, 6)
	track.BackgroundColor3 = C.off
	track.Parent = row
	corner(track, 3)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale((value - min) / (max - min), 1)
	fill.BackgroundColor3 = C.on
	fill.BorderSizePixel = 0
	fill.Parent = track
	corner(fill, 3)
	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Size = UDim2.fromOffset(14, 14)
	knob.Position = UDim2.fromScale(1, 0.5)
	knob.BackgroundColor3 = Color3.fromRGB(236, 233, 245)
	knob.Parent = fill
	corner(knob, 7)
	onAccent(function(c) tw(fill, 0.3, { BackgroundColor3 = c }) end)

	local zone = Instance.new("Frame")
	zone.BackgroundTransparency = 1
	zone.Position = UDim2.new(0, 12, 0, (compactMode and 36 or 50) - 12)
	zone.Size = UDim2.new(1, -24, 0, 30)
	zone.Parent = row
	dragArea(zone, pane, function(rel)
		local v = math.floor(min + rel * (max - min) + 0.5)
		fill.Size = UDim2.fromScale(rel, 1)
		if v ~= value then
			value = v
			num.Text = tostring(v) .. suffix
			if callback then callback(v) end
			fire(flag or title, v)
		end
	end, true, function()
		tw(knob, 0.15, { Size = UDim2.fromOffset(18, 18) })
	end, function()
		tw(knob, 0.2, { Size = UDim2.fromOffset(14, 14) }, Enum.EasingStyle.Back)
	end)
	return row
end


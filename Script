local token = 0
setOpen = function(state)
	token += 1
	local my = token
	spin.Visible = state
	if state then
		holder.Visible = true
		uiScale.Scale = curScale * 0.8
		win.GroupTransparency = 1
		tw(uiScale, 0.45, { Scale = curScale }, Enum.EasingStyle.Back)
		tw(win, 0.3, { GroupTransparency = 0 })
	else
		tw(uiScale, 0.25, { Scale = curScale * 0.8 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		local t = tw(win, 0.25, { GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			if token == my then holder.Visible = false end
		end)
	end
end

local function flip()
	isOpen = not isOpen
	setOpen(isOpen)
end

makeDraggable(mark, markRoot, flip, function()
	tw(markScale, 0.15, { Scale = 0.88 })
